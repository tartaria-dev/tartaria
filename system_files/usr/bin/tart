set -e

vitals() {
    cat <<EOF
tartaria $(cat /usr/share/tartaria/os-ver)
=======================
$(hostnamectl)
=======================
$(ostree admin status)
EOF
}

help() {
    cat <<EOF
synopsis: simple system management utility for tartaria

usage: tart [option]

options:
    help                            show this message
    sysupd                          perform system upgrade (requires auth)
    sysrlbk                         perform system rollback (requires auth)
    exec [command]                  execute a command on your host system
    rexec [command]                 execute a command on your host system as root (requires auth)
    vitals                          view host system vitals
EOF
}

# iterate throgh args
case $1 in
    help)
        help
        ;;
    upd)
        pkexec bootc upgrade
        ;;
    rlbk)
        pkexec bootc rollback
        ;;
    exec)
        shift
        bash -c "$@"
        ;;
    rexec)
        shift
        pkexec bash -c "$@"
        ;;
    vitals)
        vitals
        ;;
    *)
        help
        echo -e "\nerror: invalid argument!"
        ;;
esac