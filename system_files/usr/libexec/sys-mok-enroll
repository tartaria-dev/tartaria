#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit + pipefail
set -eo pipefail

### secureboot cert enrollment

mok_s0() {
    mkdir -p /etc/tartaria
    HASHFILE=$(mktemp)
}

mok_s1() {
    mokutil --generate-hash="tartaria" > "${HASHFILE}"
    
    if [[ -f "/usr/share/tartaria/certs/secureboot.der" ]]; then
        mokutil --import "/usr/share/tartaria/certs/secureboot.der" --hash-file "${HASHFILE}"
    fi

    rm -f "${HASHFILE}"
}

### main logic

main() {
    mok_s0
    mok_s1
}

main
