#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit + nounset + pipefail

set -euo pipefail

### secureboot cert enrollment

mokroll_prep() {
    mkdir -p /etc/tartaria
    hash_file=$(mktemp)
}

mokroll_import() {
    mokutil --generate-hash="tartaria" > "${hash_file}"
    
    if [[ -f "/usr/share/tartaria/certs/secureboot.der" ]]; then
        mokutil --import "/usr/share/tartaria/certs/secureboot.der" --hash-file "${hash_file}"
    fi

    rm -f "${hash_file}"
}

### main logic

main() {
    mokroll_prep
    mokroll_import
}

main
