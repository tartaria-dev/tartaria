set -e

# constants
MACHINEID="$(cat /etc/machine-id)"
readonly MAIN_STORE="/var/lib/subsystem"
readonly MACHINEID

# utilities
checkmnt() {
    if [[ "$1" == "-n" ]]; then
        findmnt "$2" > /dev/null && return 1 || return 0
    else
        findmnt "$1" > /dev/null
    fi
}

cre_storage_conf() {
    cp -f /etc/subsystem/default-storage.conf "$1"
    sed -i "s/PLACEHOLDER/$2/g" "$1"
    chown "$2":"$2" "$1"
}

# check if we aren't root
if [[ "$EUID" != "0" ]]; then
    echo "Please run this as an administrator."
    exit 1
fi

# check if the main store exists
if [[ ! -d "$MAIN_STORE" ]]; then
    mkdir -p "$MAIN_STORE"
fi

# check that passwd monitoring is already set up
if ! grep -qF '/usr/libexec/subsystem-store-mgr setup-configs' /var/spool/incron/root; then
    (incrontab -l 2>/dev/null; echo "/etc/passwd IN_CLOSE_WRITE /usr/libexec/subsystem-store-mgr setup-configs") | incrontab -
fi

if ! grep -qF '/usr/libexec/subsystem-store-mgr setup-stores' /var/spool/incron/root; then
    (incrontab -l 2>/dev/null; echo "/etc/passwd IN_CLOSE_WRITE /usr/libexec/subsystem-store-mgr setup-stores") | incrontab -
fi

# iterate through args
case "$1" in
    setup-configs)
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            home="/var/home/$user"
            user_conf_dir="$home/.config/containers"
            quadlet_conf="$user_conf_dir/systemd/subsystem-$MACHINEID.container"
            storage_conf="$user_conf_dir/storage.conf"
            
            # setup config directories if needed
            if [[ ! -d "$user_conf_dir/systemd" ]]; then
                echo "Creating configuration dirs for user $user."
                mkdir -p "$user_conf_dir/systemd"
                chown -R "$user":"$user" "$user_conf_dir/systemd"
            fi

            # setup storage config if needed
            if [[ ! -f "$storage_conf" ]]; then
                echo "Creating storage config for $user."
                cre_storage_conf "$storage_conf" "$user"
            elif [[ -f "$storage_conf" ]] && ! grep "/var/lib/subsystem/$user/store" "$storage_conf" > /dev/null; then
                echo "Replacing storage config for $user."
                mv "$storage_conf" "$storage_conf.bk"
                cre_storage_conf "$storage_conf" "$user"
            else
                echo "Storage config already setup for user $user."
            fi

            # setup quadlet config if needed
            if [[ ! -f "$quadlet_conf" ]]; then
                echo "Creating quadlet for $user."
                cp -f /etc/subsystem/subsystem.container "$quadlet_conf"
                chown "$user":"$user" "$quadlet_conf"
            else
                echo "Quadlet config already setup for user $user."
            fi
        done
        ;;
        
    setup-stores)
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            msdir="$MAIN_STORE/$user"
            
            # check if msdir already exists; if not, create it
            if [[ ! -d "$msdir" ]]; then
                echo "Creating subsystem store for user $user."
                mkdir -p "$msdir"/{store,store-data,.base,.work}
                chown -R "$user":"$user" "$msdir"
                chmod 700 "$msdir"
            else
                echo "Subsystem store already setup for user $user."
            fi
        done
        ;;
        
    mount-stores)
        echo "Mounting subsystem image stores."
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            msdir="$MAIN_STORE/$user"
            uid=$(id -u "$user")
            gid=$(id -g "$user")

            # ensure user has a store set up
            if [[ ! -d "$msdir" ]]; then
                echo "Refusing to operate on user $user, user does not have a subsystem store set up."
                continue
            fi

            # mount base store if not mounted
            checkmnt "$msdir/.base" && echo "Base subsystem image store for user $user already mounted, skipping."
            checkmnt -n "$msdir/.base" && mount --map-users 0:"$uid":1 --map-groups 0:"$gid":1 -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem-store/store.dsk "$msdir/.base" || true

            # mount store if not mounted
            checkmnt "$msdir/store" && echo "Subsystem image store overlay for user $user already mounted, skipping."
            checkmnt -n "$msdir/store" && mount -t overlay overlay -o index=off,lowerdir="$msdir"/.base,upperdir="$msdir"/store-data,workdir="$msdir"/.work "$msdir/store" || true
        done
        ;;
        
    unmount-stores)
        echo "Unmounting subsystem image stores."
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            msdir="$MAIN_STORE/$user"

            # ensure user has a store set up
            if [[ ! -d "$msdir" ]]; then
                echo "Refusing to operate on user $user, user does not have a subsystem store set up."
                continue
            fi

            # unmount store if mounted
            checkmnt -n "$msdir/store" && echo "Subsystem image store overlay for user $user not mounted, skipping."
            checkmnt "$msdir/store" && umount "$msdir/store" || true

            # unmount base store if mounted
            checkmnt -n "$msdir/.base" && echo "Base subsystem image store for user $user not mounted, skipping."
            checkmnt "$msdir/.base" && umount "$msdir/.base" || true
        done
        ;;
        
    *)
        echo "Subsystem store management utility 1.1.0"
        echo "Usage: $0 setup-configs|setup-stores|mount-stores|unmount-stores"
        echo "Note: This utility is not intended for use by users."
        echo "Error: no option specified"
        exit 1
        ;;
esac
