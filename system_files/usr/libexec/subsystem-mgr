#!/bin/bash

# if not root, exit
[[ "$EUID" -ne 0 ]] && echo "Not root, abort." && exit 1

set -e

if ! id "subsys" >/dev/null 2>&1; then
    # create subsys user
    groupadd -rg 767 subsys
    useradd -rmd /etc/subsystem-conf -u 767 -g 767 subsys

    # calculate and assign sub{uid,gid} range for subsys user
    next_uid=$(awk -F: '{print $2 + $3}' /etc/subuid 2>/dev/null | sort -n | tail -1)
    next_gid=$(awk -F: '{print $2 + $3}' /etc/subgid 2>/dev/null | sort -n | tail -1)
    usermod --add-subuids ${next_uid:-100000}-$((${next_uid:-100000}+65535)) --add-subgids ${next_gid:-100000}-$((${next_gid:-100000}+65535)) subsys

    # enable linger for subsys user
    loginctl enable-linger subsys
fi

case $1 in
    poweron)
        # create rootfs dirs if they don't already exist
        mkdir -p /var/lib/subsystem/{,rootfs,.rootfs-work}
        chown -R 767:767 /var/lib/subsystem/
        chmod -R 744 /var/lib/subsystem/

        # ensure subsystem service is generated
        machinectl shell subsys@.host /usr/bin/systemctl --user daemon-reload

        # setup subsystem root
        ! findmnt /usr/lib/subsystem/rootfs && mount -t erofs -o loop,ro,acl,user_xattr /usr/lib/subsystem/subsystem.dsk /usr/lib/subsystem/rootfs
        ! findmnt /subsys && mount -t overlay overlay -o index=off,metacopy=off,lowerdir=/usr/lib/subsystem/rootfs,upperdir=/var/lib/subsystem/rootfs,workdir=/var/lib/subsystem/.rootfs-work /subsys
        ! findmnt /subsys/home && mount -o bind /var/home /subsys/home

        # start subsystem container
        machinectl shell subsys@.host /usr/bin/systemctl --user start subsystem.service
        ;;
    poweroff)
        # power off subsystem container
        machinectl shell subsys@.host /usr/bin/systemctl --user stop subsystem.service

        # unmount subsystem rootfs
        findmnt /subsys/home && umount /subsys/home
        findmnt /subsys && umount /subsys
        findmnt /usr/lib/subsystem/rootfs && umount /usr/lib/subsystem/rootfs
        ;;
    *)
        echo "Usage: $0 poweron|poweroff"
        exit 1
        ;;
esac
