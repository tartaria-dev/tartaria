# if root, exit
[[ "$EUID" == "0" ]] && echo "This tool is not meant to be run as root." && exit 1

# set errexit
set -e

# set relevant variables
readonly STORE="/var/lib/subsystem/$USER"
readonly USER_UID=$(id -u)
readonly USER_GID=$(id -g)

# safety check
[[ ! -d "$STORE" ]] && echo "Subsystem data store doesn't exist. Creating, please authorize." && pkexec /usr/libexec/subsystem-store-create

case $1 in
    poweron)
        # ensure rootfs dirs exist
        echo "Preparing."
        mkdir -p "$STORE"/{rootfs,base,data/home/"$USER",.work}
        mkdir -p "$HOME"/.config/containers/systemd

        # setup subsystem root
        echo "Mounting subsystem rootfs."
        ! findmnt "$STORE"/.data/home/"$USER" > /dev/null && bindfs "$HOME" "$STORE"/data/home/"$USER" || true
        ! findmnt "$STORE"/base > /dev/null && squashfuse -o uid="$USER_UID",gid="$USER_GID" /usr/lib/subsystem/base.dsk "$STORE"/base || true
        ! findmnt "$STORE"/rootfs > /dev/null && fuse-overlayfs -o lowerdir="$STORE"/base,upperdir="$STORE"/.data -o workdir="$STORE"/.work "$STORE"/rootfs || true
        
        # ensure executing user exists in rootfs
        if ! proot -0 -r "$STORE/rootfs" getent passwd "$USER" >/dev/null 2>&1; then
            echo "Creating user $USER."
            proot -0 -r "$STORE/rootfs" groupadd -g "$USER_GID" "$USER"
            proot -0 -r "$STORE/rootfs" useradd -md "/home/$USER" -u "$USER_UID" -g "$USER_GID" "$USER"
            echo "$USER ALL=(ALL:ALL) ALL" > "$STORE"/rootfs/etc/sudoers.d/"$USER" && chmod 0440 "$STORE"/rootfs/etc/sudoers.d/"$USER"
            echo "Created user $USER, uid $USER_UID, gid $USER_GID"
        fi

        # ensure quadlet exists and is loaded
        echo "Loading services."
        [[ -f "$HOME"/.config/containers/systemd/subsystem.container ]] && cp -f /etc/skel/.config/containers/systemd/subsystem.container
        systemctl --user daemon-reload

        # start subsystem
        echo "Starting subsystem."
        systemctl --user start subsystem
        ;;
    poweroff)
        # power off subsystem container
        echo "Stopping subsystem."
        systemctl --user stop subsystem.service

        # unmount subsystem rootfs (if mounted)
        echo "Unmounting subsystem rootfs."
        findmnt "$STORE"/rootfs > /dev/null && fusermount3 -u "$STORE"/rootfs || true
        findmnt "$STORE"/data/home/"$USER" > /dev/null && fusermount3 -u "$STORE"/data/home/"$USER" || true
        findmnt "$STORE"/base > /dev/null && fusermount3 -u "$STORE"/base || true
        ;;
    enter-subsystem)
        # open subsystem shell
        echo "Opening shell."
        podman exec -u "$USER" -it subsystem /bin/bash
        ;;
    *)
        echo "Usage: $0 poweron|poweroff|enter-subsystem-as <username>"
        exit 1
        ;;
esac
