#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# LOVE MEEEEEE
set -eo pipefail

# sync config files
if [[ ! -f /etc/greetd/.no-sync ]]; then
    if grep -Eq "maraska|berbere" /usr/lib/os-release; then
        cp -a /usr/share/greeter-defaults/noctalia/config.toml /etc/greetd/config.toml
        cp -a /usr/share/greeter-defaults/sync.toml /var/lib/noctalia-greeter/sync.toml
    elif grep -Eq "saffron|amchoor" /usr/lib/os-release; then
        cp -a /usr/share/greeter-defaults/duxshell/config.toml /etc/greetd/config.toml
    fi
fi