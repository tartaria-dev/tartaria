#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# LOVE MEEEEEE
set -eo pipefail

# sync greetd config (always)
if grep -Eq "maraska|berbere" /usr/lib/os-release; then
    cp -af /usr/share/greeter-defaults/noctalia/config.toml /etc/greetd/config.toml
elif grep -Eq "saffron|amchoor" /usr/lib/os-release; then
    cp -af /usr/share/greeter-defaults/duxshell/config.toml /etc/greetd/config.toml
fi

# sync respective greeter config files (one-time)
if grep -Eq "maraska|berbere" /usr/lib/os-release; then
    if [[ ! -f /etc/greetd/.no-sync-noctalia ]]; then
        touch /etc/greetd/.no-sync-noctalia
        cp -af /usr/share/greeter-defaults/sync.toml /var/lib/noctalia-greeter/sync.toml
    fi
elif grep -Eq "saffron|amchoor" /usr/lib/os-release; then
    if [[ ! -f /etc/greetd/.no-sync-duxshell ]]; then
        touch /etc/greetd/.no-sync-duxshell
        cp -arf /usr/share/greeter-defaults/duxshell/*.json /var/cache/dms-greeter/
    fi
fi
