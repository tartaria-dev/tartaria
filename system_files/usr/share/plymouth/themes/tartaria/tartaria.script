// ---------------- window / background ----------------

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// ---------------- centered logo ----------------

logo.image = Image("logo/logo.png");
logo.sprite = Sprite(logo.image);
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.sprite.SetX((screen_width  - logo.w) / 2);
logo.sprite.SetY((screen_height - logo.h) / 2);
logo.sprite.SetZ(5);

// ---------------- animation frames ----------------

frame.count = 85;
frame.fps   = 30;
frame.dir   = "frames/";
frame.bottom_margin = screen_height * 0.02;

fun pad5(n) {
    if (n < 10)    return "0000" + n;
    if (n < 100)   return "000" + n;
    if (n < 1000)  return "00" + n;
    if (n < 10000) return "0" + n;
    return "" + n;
}

frame.images = [];
for (frame.i = 1; frame.i <= frame.count; frame.i++) {
    frame.images[frame.i - 1] = Image(frame.dir + "frame" + pad5(frame.i) + ".png");
}

frame.sprite = Sprite(frame.images[0]);
frame.w = frame.images[0].GetWidth();
frame.h = frame.images[0].GetHeight();
frame.x = (screen_width - frame.w) / 2;
frame.y = screen_height - frame.h - frame.bottom_margin;
frame.sprite.SetX(frame.x);
frame.sprite.SetY(frame.y);
frame.sprite.SetZ(10);

frame.current = 0;
frame.hidden_for_prompt = 0;

Plymouth.SetRefreshRate(frame.fps);

fun refresh_callback() {
    frame.current = (frame.current + 1) % frame.count;
    frame.sprite.SetImage(frame.images[frame.current]);
}
Plymouth.SetRefreshFunction(refresh_callback);

// Swap the animation out of view so the prompt can occupy the same
// screen area (called from the prompt callbacks below).
fun hide_animation_for_prompt() {
    if (frame.hidden_for_prompt == 0) {
        frame.hidden_for_prompt = 1;
        frame.sprite.SetVisible(false);
        frame.sprite.SetX(-10000);
    }
}

// Bring the animation back once the prompt is answered/dismissed.
fun show_animation_after_prompt() {
    if (frame.hidden_for_prompt == 1) {
        frame.hidden_for_prompt = 0;
        frame.sprite.SetX(frame.x);
        frame.sprite.SetVisible(true);
    }
}

// ---------------- password / question prompt ----------------
// Occupies the same bottom-anchored area the animation uses, so it
// visually replaces it while a prompt is active.

prompt.y = frame.y - 15;

prompt.label_sprite = Sprite();
prompt.label_sprite.SetZ(10);
prompt.label_sprite.SetVisible(false);

prompt.entry_sprite = Sprite();
prompt.entry_sprite.SetZ(10);
prompt.entry_sprite.SetVisible(false);

prompt.message_sprite = Sprite();
prompt.message_sprite.SetZ(20);
prompt.message_sprite.SetVisible(false);

fun show_prompt_label(text) {
    if (text == "" || text == "#NULL") {
        text = "Password:";
    }
    label_image = Image.Text(text, 0.92, 0.92, 0.92, 1, "Overpass 14");
    prompt.label_sprite.SetImage(label_image);
    prompt.label_sprite.SetX((screen_width - label_image.GetWidth()) / 2);
    prompt.label_sprite.SetY(prompt.y);
    prompt.label_sprite.SetVisible(true);
}

fun show_prompt_entry(display_text) {
    entry_image = Image.Text(display_text, 1, 1, 1, 1, "Overpass 18");
    prompt.entry_sprite.SetImage(entry_image);
    prompt.entry_sprite.SetX((screen_width - entry_image.GetWidth()) / 2);
    prompt.entry_sprite.SetY(prompt.y + 26);
    prompt.entry_sprite.SetVisible(true);
}

// Called for every keystroke while a password is being typed.
// `bullets` is the number of characters entered so far.
fun display_password_callback(prompt_text, bullets) {
    hide_animation_for_prompt();
    show_prompt_label(prompt_text);

    dots = "";
    n = 0;
    while (n < bullets) {
        dots = dots + "●";
        n = n + 1;
    }
    show_prompt_entry(dots);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

// Called for plain (non-masked) text prompts, e.g. a username or
// a yes/no confirmation entered during boot.
fun display_question_callback(prompt_text, entry_text) {
    hide_animation_for_prompt();
    show_prompt_label(prompt_text);
    show_prompt_entry(entry_text);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

// Called when Plymouth returns to normal boot display (prompt answered
// or dismissed) — hide the prompt UI and bring the animation back.
fun display_normal_callback() {
    prompt.label_sprite.SetVisible(false);
    prompt.entry_sprite.SetVisible(false);
    // Visibility alone can leave stale pixels behind on some renderers
    // (damage tracking doesn't always pick up a pure visibility flip).
    // Moving the sprites off-screen forces the old region to redraw.
    prompt.label_sprite.SetX(-10000);
    prompt.entry_sprite.SetX(-10000);

    show_animation_after_prompt();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---------------- status / error messages ----------------
// 40px above the bottom of the screen — below the animation/prompt area.

message.bottom_margin = screen_height * 0.04;   // ~4% of screen height above the bottom

// Called for status/error messages, e.g. "Wrong password, try again"
// from a failed LUKS unlock attempt, or fsck output.
fun message_callback(text) {
    if (text == "") {
        prompt.message_sprite.SetVisible(false);
        return;
    }
    message_image = Image.Text(text, 1, 0.55, 0.55, 1, "Overpass 12");
    prompt.message_sprite.SetImage(message_image);
    prompt.message_sprite.SetX((screen_width - message_image.GetWidth()) / 2);
    prompt.message_sprite.SetY(screen_height - message.bottom_margin - message_image.GetHeight());
    prompt.message_sprite.SetVisible(true);
}
Plymouth.SetMessageFunction(message_callback);

// Fires when the corresponding hide-message command is sent (not just
// an empty display-message) — without this the message sprite never
// clears itself.
fun hide_message_callback(text) {
    prompt.message_sprite.SetVisible(false);
}
Plymouth.SetHideMessageFunction(hide_message_callback);
