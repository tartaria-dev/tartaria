[Unit]
Description=Enroll Secureboot Certificate
Before=systemd-modules-load.service
ConditionKernelCommandLine=rd.live.image

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/sys-mok-enroll
ExecStart=/usr/bin/systemctl disable %n
ExecStart=/usr/bin/systemctl mask %n

[Install]
WantedBy=multi-user.target
