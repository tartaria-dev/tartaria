[Unit]
Description=Enable subsystem store monitoring for new users

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'echo "/etc/passwd IN_MODIFY /usr/libexec/subsystem-store-create" | incrontab -'
ExecStart=/usr/bin/systemctl disable subsystem-store-monitor.service
ExecStart=/usr/bin/systemctl mask subsystem-store-monitor.service
RemainAfterExit=false

[Install]
WantedBy=multi-user.target