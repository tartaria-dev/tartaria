[Unit]
Description=Bind mount for cherries
ConditionPathExists=/etc/.cherries-are-picked
RequiresMountsFor=/var/lib/cherries /usr/share/tartaria/cherries
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Mount]
What=/var/lib/cherries
Where=/usr/share/tartaria/cherries
Type=none
Options=bind

[Install]
WantedBy=multi-user.target