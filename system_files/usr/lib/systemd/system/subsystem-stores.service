[Unit]
Description=Subsystem store management
After=systemd-logind.service local-fs.target
BindsTo=systemd-logind.service local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/subsystem/bin/store-mgr setup-configs
ExecStart=/usr/lib/subsystem/bin/store-mgr setup-stores
ExecStart=/usr/lib/subsystem/bin/store-mgr mount-stores
ExecStop=/usr/lib/subsystem/bin/store-mgr unmount-stores
RemainAfterExit=yes
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target default.target