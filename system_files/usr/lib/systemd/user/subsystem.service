[Unit]
Description=Subsystem for %u
After=graphical-session.target
RequiresMountsFor=%t/containers
RequiresMountsFor=/run/user/%U

[Service]
Type=notify
Delegate=yes
KillMode=mixed
NotifyAccess=all
SyslogIdentifier=%N
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecStart=/usr/lib/subsystem/bin/subsystem start
ExecStop=/usr/lib/subsystem/bin/subsystem stop
RemainAfterExit=yes
Restart=always
RestartSec=1s
TimeoutStopSec=15s

[Install]
WantedBy=graphical-session.target
