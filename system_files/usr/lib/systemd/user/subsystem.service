[Unit]
Description=Subsystem for %u
After=graphical-session.target
RequiresMountsFor=%t/containers
RequiresMountsFor=/run/user/%U

[Service]
Type=notify
Delegate=yes
KillMode=mixed
NotifyAccess=all
SyslogIdentifier=%N
TimeoutStopSec=5s
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecStart=/usr/lib/subsystem/bin/subsystem start
ExecStop=/usr/lib/subsystem/bin/subsystem stop

[Install]
WantedBy=graphical-session.target