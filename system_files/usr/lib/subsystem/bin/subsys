#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

# utilities
help() {
    cat <<EOF
usage:
    subsys <command> [options...]

synopsis:
    per-user subsystem management tools

commands:
    diag                            view journalctl logs
    restart                         restart subsystem
    disable                         disable subsystem

EOF
}

# iterate through args
case $1 in
    diag)
        # pull up journalctl logs
        journalctl --user -xeu subsystem-containerd
        ;;
    restart)
        # warn user
        echo "[-i-] Restarting subsystem."
        echo "[-i-] Any running tasks in the subsystem will be stopped."
        echo "[-i-] To continue, press any key, or press CTRL+C to abort."

        # await user input
        read -srn1

        # create file so the shell knows about the restart
        touch "$HOME"/.cache/subsys-restart

        # start seperate job to restart the container
        /usr/libexec/host-spawn nohup bash -c "systemctl --user restart subsystem-containerd" >/dev/null 2>&1 &
        ;;
    disable)
        # warn user
        echo "[-i-] Disabling subsystem."
        echo "[-i-] This will disable the subsystem and give you a standard host bash shell."
        echo "[-i-] Press any key to continue, or CTRL+C to abort."

        # await user input
        read -srn1

        # create file
        mkdir -p "$HOME"/.config/subsystem
        touch "$HOME"/.config/subsystem/disable

        # notify user of changes
        echo "[-i-] Subsystem disabled. Log out and back in to apply changes."
        ;;
    *)
        # check for no argument or invalid argument
        if [[ -z "$*" ]]; then
            echo "[!!!] No command provided."
        else
            echo "[!!!] Invalid argument."
        fi

        # how to write good comments?
        help
        exit 1
esac