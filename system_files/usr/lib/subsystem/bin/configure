#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

set -e

# constants
MSDIR="/tmp/subsystem-$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')"
readonly MSDIR

# do our checks
if [[ -z $1 ]]; then
    echo "Insufficient parameters."
    exit 1
elif [[ "$EUID" == "0" ]]; then
    echo "Please do not run this as an administrator."
    exit 1
elif [[ "$(systemctl is-failed subsystem-stores)" != "active" ]]; then
    echo "Subsystem store management has failed/is inactive."
    exit 1  
elif [[ ! -d "$MSDIR" ]]; then
    echo "We do not have a configured subsystem image store."
    exit 1
elif ! findmnt "$MSDIR/store" >/dev/null; then
    echo "Our subsystem image store isn't properly mounted."
    exit 1
fi

# say some crap
echo "Checking configurations."

# setup storage config if needed
if [[ ! -f "$HOME/.config/containers/storage.conf" ]]; then
    echo "Creating storage config."
    cp -f /usr/lib/subsystem/defaults/storage.conf "$HOME/.config/containers/storage.conf"
    sed -i "s/PLACEHOLDER/$MSDIR/g" "$HOME/.config/containers/storage.conf"
elif [[ -f "$HOME/.config/containers/storage.conf" ]] && ! grep -qF "$MSDIR/store" "$HOME/.config/containers/storage.conf"; then
    echo "Replacing storage config."
    mv "$HOME/.config/containers/storage.conf" "$HOME/.config/containers/storage.conf.bk"
    cp -f /usr/lib/subsystem/defaults/storage.conf "$HOME/.config/containers/storage.conf"
    sed -i "s/PLACEHOLDER/$MSDIR/g" "$HOME/.config/containers/storage.conf"
fi

# setup subsystem config dir if needed
if [[ ! -d "$HOME/.config/subsystem" ]]; then
    mkdir -p "$HOME/.config/subsystem"
fi

# setup ignition config if needed
if [[ ! -f "$HOME/.config/subsystem/ignition" ]]; then
    echo "Creating ignition config."
    cp -f /usr/lib/subsystem/defaults/ignition "$HOME/.config/subsystem/ignition"
fi

echo "Configuration done!"
