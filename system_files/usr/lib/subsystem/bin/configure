#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

set -e

# iterate through users
for user in $(/usr/libexec/run-as-all-human-users --list); do
    # check if user has sub{uid,gid} entries, skip if not
    if ! grep -q "$user" /etc/subuid || ! grep -q "$user" /etc/subuid; then
        echo "$user has no sub{uid,gid} entries, skipping."
        continue
    fi

    # constants
    subuid=$(grep "^$user:" /etc/subuid | cut -d: -f3)
    subgid=$(grep "^$user:" /etc/subgid | cut -d: -f3)

    echo "Configuring subsystem for $user..."

    # setup rootfs storage dirs if needed
    if [[ ! -d "/var/home/$user/.local/share/subsystem" ]]; then
        mkdir -p "/var/home/$user/.local/share/subsystem/"{rootfs,basefs,fsdata,.work}
        chown -R "$subuid":"$subgid" "/var/home/$user/.local/share/subsystem/"{rootfs,basefs,fsdata,.work}
    fi

    # setup config dir if needed
    if [[ ! -d "/var/home/$user/.config/subsystem" ]]; then
        mkdir -p "/var/home/$user/.config/subsystem"
        cp -r /usr/lib/subsystem/defaults/* "/var/home/$user/.config/subsystem"
        chown -R "$user":"$user" "/var/home/$user/.config/subsystem"
    fi

    echo "Done."
done