#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$1" != "mount" ]] && [[ "$1" != "unmount" ]]; then
    echo "[!!!] No mount action defined."
    echo "[---] Usage: $0 mount|unmount --user=USER --rfsdir=PATH/TO/RFSDIR"
    exit 64
elif [[ $* != *--user=* ]] || [[ $* != *--rfsdir=* ]]; then
    echo "[!!!] Arguments --user or --rfsdir were not used."
    echo "[!!!] Both arguments and their respective values are required for this command to function."
    echo "[---] Usage: $0 mount|unmount --user=USER --rfsdir=PATH/TO/RFSDIR"
    exit 64
elif [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

# parse arguments
for arg in "$@"; do
    case $arg in
        mount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=mount
            readonly ACTION
            ;;

        unmount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=unmount
            readonly ACTION
            ;;

        --user=*)
            TARGETUSR="${arg#*=}"
            USER_SUBUID_START=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBGID_START=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBUID_RANGE=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f3)
            USER_SUBGID_RANGE=$(grep "^$TARGETUSR:" /etc/subgid | cut -d: -f3)
            readonly TARGETUSR
            readonly USER_SUBUID_START
            readonly USER_SUBGID_START
            readonly USER_SUBUID_RANGE
            readonly USER_SUBGID_RANGE

            if [[ -z $USER_SUBUID_START ]] || [[ -z $USER_SUBGID_START ]] || [[ -z $USER_SUBUID_RANGE ]] || [[ -z $USER_SUBGID_RANGE ]]; then
                echo "[!!!] $TARGETUSR does not have sub{uid,gid}s configured properly."
                exit 78
            fi
            ;;

        --hash=*)
            HASH="${arg#*=}"
            readonly HASH
            ;;

        --rfsdir=*)
            RFSDIR="${arg#*=}"
            readonly RFSDIR
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# run mount/unmount action
case $ACTION in
    mount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in mounting process, cleaning up." && pkexec /usr/lib/subsystem/bin/filesystem unmount --store="$RFSDIR" --user="$TARGETUSR"' EXIT

        # (re)mount base filesystem
        if ! findmnt "$RFSDIR"/base >/dev/null; then
            echo "[i] Mounting base filesystem."
            mkdir -p "$RFSDIR"/base
            chown -R "$TARGETUSR":"$TARGETUSR" "$RFSDIR"
            mount --map-users 0:"$USER_SUBUID_START":"$USER_SUBUID_RANGE" --map-groups 0:"$USER_SUBGID_START":"$USER_SUBGID_RANGE" -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$RFSDIR"/base
        else
            echo "[i] Remounting base filesystem."
            umount -q "$RFSDIR"/base
            mount --map-users 0:"$USER_SUBUID_START":"$USER_SUBUID_RANGE" --map-groups 0:"$USER_SUBGID_START":"$USER_SUBGID_RANGE" -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$RFSDIR"/base
        fi

        # initialize ostree repo and commit rootfs if needed
        if [[ ! -d "/var/lib/subsystem/repo/$HASH" ]]; then
            echo "[i] Initializing rootfs repository."
            mkdir -p /var/lib/subsystem/repo/"$HASH"
            chown "$TARGETUSR":"$TARGETUSR" /var/lib/subsystem/repo/"$HASH"
            ostree --repo="/var/lib/subsystem/repo/$HASH" init --mode=bare
            ostree --repo="/var/lib/subsystem/repo/$HASH" commit --branch="subsystem-$TARGETUSR" --subject="subsystem snapshot for $TARGETUSR" "$RFSDIR"/base
        fi

        # clean checkout destination to ensure checkout accuracy
        if [[ -d "/var/lib/subsystem/content/$HASH" ]]; then
            echo "[i] Cleaning previous checkout."
            rm -rf /var/lib/subsystem/content/"$HASH"/*
        else
            echo "[i] Creating checkout destination."
            mkdir -p /var/lib/subsystem/content/"$HASH"/
            chown "$TARGETUSR":"$TARGETUSR" /var/lib/subsystem/content/"$HASH"
        fi

        # checkout commit
        echo "[i] Checking out and mounting rootfs."
        ostree --repo="/var/lib/subsystem/repo/$HASH" checkout -H "subsystem-$TARGETUSR" /var/lib/subsystem/content/"$HASH"
        mount -o ro,bind /var/lib/subsystem/content/"$HASH" /var/lib/subsystem/content/"$HASH"

        # cleanup
        echo "[i] Cleaning up."
        umount -q "$RFSDIR"/base
        rm -rf "$RFSDIR"/base
        
        # reset traps
        trap - EXIT
        ;;
    unmount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in unmounting process, manual intervention is required."' EXIT

        # unmount filesystem
        if findmnt /var/lib/subsystem/content/"$HASH" >/dev/null; then
            echo "[i] Unmounting rootfs."
            umount -q /var/lib/subsystem/content/"$HASH"
        else 
            echo "[!!] Filesystem appears to be unmounted already, ignoring."
        fi

        # cleanup
        echo "[i] Cleaning up."
        rm -rf /var/lib/subsystem/content/"$HASH"/*

        # reset traps
        trap - EXIT
        ;;
    *)
        echo "[!!!] No action defined."
        echo "[---] Usage: $0 mount|unmount --user=USER --hash=HASH --rfsdir=PATH/TO/RFSDIR"
        exit 64
        ;;
esac

exit 0