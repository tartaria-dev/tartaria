#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$1" != "mount" ]] && [[ "$1" != "unmount" ]]; then
    echo "[!!!] No mount action defined."
    echo "[---] Usage: $0 mount|unmount --store=/PATH/TO/STORE --user=USER"
    exit 64
elif [[ $* != *--store=* ]] || [[ $* != *--user=* ]]; then
    echo "[!!!] Arguments --store or --user were not used."
    echo "[---] Usage: $0 mount|unmount --store=/PATH/TO/STORE --user=USER"
    exit 64
elif [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

# parse arguments
for arg in "$@"; do
    case $arg in
        --store=*)
            MSDIR="${arg#*=}"
            readonly MSDIR
            ;;

        --user=*)
            TARGETUSR="${arg#*=}"
            USER_UID=$(id -u "$TARGETUSR")
            USER_SUBUID=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBGID=$(grep "^$TARGETUSR:" /etc/subgid | cut -d: -f2)
            readonly TARGETUSR
            readonly USER_UID
            readonly USER_SUBUID
            readonly USER_SUBGID
            if [[ -z $USER_SUBUID ]] || [[ -z $USER_SUBGID ]]; then
                echo "[!!!] $TARGETUSR does not have sub{uid,gid}s configured."
                exit 78
            fi
            ;;

        mount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=mount
            readonly ACTION
            ;;

        unmount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=unmount
            readonly ACTION
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# run mount/unmount action
case $ACTION in
    mount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in mounting process, cleaning up." && pkexec /usr/lib/subsystem/bin/filesystem unmount --store="$MSDIR" --user="$TARGETUSR"' EXIT

        # ensure required dirs exist
        mkdir -p "$MSDIR"/{rootfs,lower,upper/{upper-data,upper-work}}

        # (re)mount lower filesystem
        if ! findmnt "$MSDIR"/lower >/dev/null; then
            echo "[i] Mounting lower filesystem."
            mount --map-users 0:"$USER_SUBUID":1 --map-groups 0:"$USER_SUBGID":1 -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$MSDIR"/lower
        else
            echo "[i] Remounting lower filesystem."
            mount --map-users 0:"$USER_SUBUID":1 --map-groups 0:"$USER_SUBGID":1 -o ro,acl,loop,user_xattr,remount -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$MSDIR"/lower
        fi

        # (re)mount upper filesystem
        if ! findmnt "$MSDIR"/fsdata >/dev/null; then
            echo "[i] Mounting upper filesystem."
            mount --map-users "$USER_UID":"$USER_SUBUID":1 --map-groups "$USER_UID":"$USER_SUBGID":1 --bind "$MSDIR"/upper "$MSDIR"/upper
        else
            echo "[i] Remounting upper filesystem."
            mount --map-users "$USER_UID":"$USER_SUBUID":1 --map-groups "$USER_UID":"$USER_SUBGID":1 -o remount --bind "$MSDIR"/upper "$MSDIR"/upper
        fi

        # (re)mount rootfs
        if ! findmnt "$MSDIR"/rootfs >/dev/null; then
            echo "[i] Mounting rootfs."
            mount -t overlay overlay -o index=off,lowerdir="$MSDIR"/lower,upperdir="$MSDIR"/upper/upper-data,workdir="$MSDIR"/upper/upper-work "$MSDIR"/rootfs
        else
            echo "[i] Remounting rootfs."
            mount -t overlay overlay -o remount,index=off,lowerdir="$MSDIR"/lower,upperdir="$MSDIR"/upper/upper-data,workdir="$MSDIR"/upper/upper-work "$MSDIR"/rootfs
        fi

        # reset traps
        trap - EXIT
        ;;
    unmount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in unmounting process, manual intervention is required."' EXIT

        # unmount upper filesystem
        if findmnt "$MSDIR"/rootfs >/dev/null; then
            echo "[i] Unmounting rootfs."
            umount -q "$MSDIR"/rootfs
        fi

        # unmount filesystem data
        if findmnt "$MSDIR"/upper >/dev/null; then
            echo "[i] Unmounting upper filesystem."
            umount -q "$MSDIR"/upper
        fi

        # unmount lower filesystem
        if findmnt "$MSDIR"/lower >/dev/null; then
            echo "[i] Unmounting lower filesystem."
            umount -q "$MSDIR"/lower
        fi

        # reset traps
        trap - EXIT
        ;;
    *)
        echo "[!!!] No action defined."
        echo "[---] Usage: $0 mount|unmount --store=/PATH/TO/STORE --user=USER"
        exit 64
        ;;
esac

exit 0