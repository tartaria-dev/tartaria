#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$1" != "mount" ]] && [[ "$1" != "unmount" ]]; then
    echo "[!!!] No mount action defined."
    echo "[---] Usage: $0 mount|unmount --store=/PATH/TO/STORE --user=USER"
    exit 64
elif [[ $* != *--store=* ]] || [[ $* != *--user=* ]]; then
    echo "[!!!] Arguments --store or --user were not used."
    echo "[---] Usage: $0 mount|unmount --store=/PATH/TO/STORE --user=USER"
    exit 64
elif [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

# parse arguments
for arg in "$@"; do
    case $arg in
        --store=*)
            MSDIR="${arg#*=}"
            readonly MSDIR
            ;;

        --user=*)
            TARGETUSR="${arg#*=}"
            USER_SUBUID=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBGID=$(grep "^$TARGETUSR:" /etc/subgid | cut -d: -f2)
            readonly USER_SUBUID
            readonly USER_SUBGID
            ;;

        mount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=mount
            readonly ACTION
            ;;

        unmount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=unmount
            readonly ACTION
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# ensure target user has sub{uid,gid}s configured
if [[ -z $USER_SUBUID ]] || [[ -z $USER_SUBGID ]]; then
    echo "[!!!] $TARGETUSR does not have sub{uid,gid}s configured."
    exit 78
fi

# run mount/unmount action
case $ACTION in
    mount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in mounting process, cleaning up." && pkexec /usr/lib/subsystem/bin/filesystem unmount --store="$MSDIR" --user="$TARGETUSR"' EXIT

        # (re)mount lower filesystem
        if ! findmnt "$MSDIR"/basefs >/dev/null; then
            echo "[---] Mounting lower filesystem."
            mount --map-users 0:"$USER_SUBUID":1 --map-groups 0:"$USER_SUBGID":1 -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$MSDIR/basefs"
        else
            echo "[---] Remounting lower filesystem."
            fuser -mk -15 "$MSDIR"/basefs || true
            umount -q "$MSDIR"/basefs
            mount --map-users 0:"$USER_SUBUID":1 --map-groups 0:"$USER_SUBGID":1 -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$MSDIR/basefs"
        fi

        # (re)mount upper filesystem
        if ! findmnt "$MSDIR"/rootfs >/dev/null; then
            echo "[---] Mounting upper filesystem."
            mount -t overlay overlay -o index=off,lowerdir="$MSDIR"/basefs,upperdir="$MSDIR"/fsdata,workdir="$MSDIR"/.work "$MSDIR"/rootfs
        else
            echo "[---] Remounting upper filesystem."
            fuser -mk -15 "$MSDIR"/rootfs || true
            umount -q "$MSDIR"/rootfs
            mount -t overlay overlay -o index=off,lowerdir="$MSDIR"/basefs,upperdir="$MSDIR"/fsdata,workdir="$MSDIR"/.work "$MSDIR"/rootfs
        fi

        # reset traps
        trap - EXIT
        ;;
    unmount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in unmounting process, manual intervention is required."' EXIT

        # unmount upper filesystem
        if findmnt "$MSDIR"/rootfs >/dev/null; then
            echo "[---] Unmounting upper filesystem."
            fuser -mk -15 "$MSDIR"/rootfs || true
            umount -q "$MSDIR"/rootfs
        fi

        # unmount lower filesystem
        if findmnt "$MSDIR"/basefs >/dev/null; then
            echo "[---] Unmounting lower filesystem."
            fuser -mk -15 "$MSDIR"/basefs || true
            umount -q "$MSDIR"/basefs
        fi

        # reset traps
        trap - EXIT
        ;;
    *)
        echo "[!!!] No action defined."
        exit 1
        ;;
esac

exit 0