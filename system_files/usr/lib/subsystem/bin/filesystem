#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$1" != "mount" ]] && [[ "$1" != "unmount" ]]; then
    echo "[!!!] No mount action defined."
    echo "[---] Usage: $0 mount|unmount --user=USER --hash=HASH"
    exit 64
elif [[ $* != *--user=* ]] || [[ $* != *--rfsdir=* ]]; then
    echo "[!!!] Arguments --user or --rfsdir were not used."
    echo "[!!!] Both arguments and their respective values are required for this command to function."
    echo "[---] Usage: $0 mount|unmount --user=USER --hash=HASH"
    exit 64
elif [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

# parse arguments
for arg in "$@"; do
    case $arg in
        mount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=mount
            readonly ACTION
            ;;

        unmount)
            [[ "$arg" != "$1" ]] && continue
            ACTION=unmount
            readonly ACTION
            ;;

        --user=*)
            TARGETUSR="${arg#*=}"
            USER_SUBUID_START=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBGID_START=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f2)
            USER_SUBUID_RANGE=$(grep "^$TARGETUSR:" /etc/subuid | cut -d: -f3)
            USER_SUBGID_RANGE=$(grep "^$TARGETUSR:" /etc/subgid | cut -d: -f3)
            readonly TARGETUSR
            readonly USER_SUBUID_START
            readonly USER_SUBGID_START
            readonly USER_SUBUID_RANGE
            readonly USER_SUBGID_RANGE

            if [[ -z $USER_SUBUID_START ]] || [[ -z $USER_SUBGID_START ]] || [[ -z $USER_SUBUID_RANGE ]] || [[ -z $USER_SUBGID_RANGE ]]; then
                echo "[!!!] $TARGETUSR does not have sub{uid,gid}s configured properly."
                exit 78
            fi
            ;;

        --hash=*)
            HASH="${arg#*=}"
            REPODIR="/var/lib/subsystem/$HASH"
            readonly HASH
            readonly REPODIR
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# run mount/unmount action
case $ACTION in
    mount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in mounting process, cleaning up." && pkexec /usr/lib/subsystem/bin/filesystem unmount --user="$TARGETUSR" --hash="$HASH"' EXIT

        # ensure base directories exist
        mkdir -p "$REPODIR"/{repo,base,content}

        # (re)mount base filesystem
        if ! findmnt "$REPODIR"/base >/dev/null; then
            echo "[i] Mounting basefs."
            mount --map-users 0:"$USER_SUBUID_START":"$USER_SUBUID_RANGE" --map-groups 0:"$USER_SUBGID_START":"$USER_SUBGID_RANGE" -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$REPODIR"/base
        else
            echo "[i] Remounting basefs."
            umount -q "$REPODIR"/base
            mount --map-users 0:"$USER_SUBUID_START":"$USER_SUBUID_RANGE" --map-groups 0:"$USER_SUBGID_START":"$USER_SUBGID_RANGE" -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/rootfs/rootfs.dsk "$REPODIR"/base
        fi

        # initialize ostree repo and commit rootfs if needed
        if [[ ! -d "$REPODIR/.initialized" ]]; then
            echo "[i] Initializing rootfs repository."
            ostree --repo="$REPODIR/repo" init --mode=bare
            ostree --repo="$REPODIR/repo" commit --branch="subsystem-rootfs-$TARGETUSR" --subject="subsystem rootfs snapshot for $TARGETUSR" "$REPODIR"/base
            touch "$REPODIR/.initialized"
        fi

        # clean checkout destination to ensure checkout accuracy
        if [[ -n $(find "$REPODIR"/content -maxdepth 0 -not -empty) ]]; then
            rm -rf "$REPODIR"/content/*
        fi

        # checkout commit
        echo "[i] Checking out rootfs."
        ostree --repo="$REPODIR/repo" checkout -H "subsystem-rootfs-$TARGETUSR" "$REPODIR"/content

        # lock repodir from runtime modification
        echo "[i] Locking repository."
        mount -o ro,bind "$REPODIR" "$REPODIR"

        # unmount basefs
        echo "[i] Unmounting basefs."
        umount -q "$REPODIR"/base
        
        # reset traps
        trap - EXIT
        ;;
    unmount)
        # trap EXIT
        trap 'echo "[!!!] Error occured in unmounting process, manual intervention is required."' EXIT

        # unlock repository
        if findmnt "$REPODIR" >/dev/null; then
            echo "[i] Unlocking repository."
            umount -q "$REPODIR"
        else 
            echo "[!!] Repository seems to be unlocked already, ignoring."
        fi

        # cleanup
        echo "[i] Cleaning up."
        rm -rf "$REPODIR"/content/*

        # reset traps
        trap - EXIT
        ;;
    *)
        echo "[!!!] No action defined."
        echo "[---] Usage: $0 mount|unmount --user=USER --hash=HASH"
        exit 64
        ;;
esac

exit 0