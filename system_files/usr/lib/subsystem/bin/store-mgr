set -e

# do our checks
if [[ -z $1 ]]; then
    echo "Insufficient parameters."
    exit 1
elif [[ "$EUID" != "0" ]]; then
    echo "Please run this as an administrator."
    exit 1
fi

# ensure passwd monitoring is set up
if ! grep -qF '/usr/lib/subsystem/bin/store-mgr mount-stores' /var/spool/incron/root; then
    (incrontab -l 2>/dev/null; echo "/etc/passwd IN_CLOSE_WRITE /usr/lib/subsystem/bin/store-mgr mount-stores") | incrontab -
fi

# iterate through args
case "$1" in
    mount-stores)
        echo "Mounting subsystem image stores."
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            msdir="/tmp/subsystem-$(echo -n "$(cat /etc/machine-id)$user" | sha256sum | awk '{print $1}')"
            uid=$(id -u "$user")
            gid=$(id -g "$user")

            # ensure user doesn't have a store set up
            if [[ -d "$msdir" ]] && findmnt "$msdir/store" >/dev/null; then
                echo "Skipping $user, they have a store set up."
                continue
            elif [[ -d "$msdir" ]] && ! findmnt "$msdir/store" >/dev/null; then
                echo "User $user has an improperly setup store, resetting it."
                rm -rf "$msdir"
            fi

            # create main store dir
            mkdir -p "$msdir"/{store,lockstruct}

            # mount subsystem image store with idmap
            mount --map-users 0:"$uid":1 --map-groups 0:"$gid":1 -o ro,acl,loop,user_xattr -t erofs /usr/lib/subsystem/store/store.dsk "$msdir/store"
            
            # create and bind mount lockfile structure
            for lockfile in $(find "$msdir/store" -type f -name "*.lock" | grep -vF "$msdir/store/overlay/"); do
                dest=${lockfile#"$msdir/store/"}

                mkdir -p "$msdir/lockstruct/$(dirname "$dest")"
                cp -f "$lockfile" "$msdir/lockstruct/$dest"
                chown "$uid":"$gid" "$msdir/lockstruct/$dest"

                mount --bind "$msdir/lockstruct/$dest" "$lockfile"
            done
        done
        ;;
        
    unmount-stores)
        echo "Unmounting subsystem image stores."
        for user in $(/usr/libexec/run-as-all-human-users --list); do
            msdir="/tmp/subsystem-$(echo -n "$(cat /etc/machine-id)$user" | sha256sum | awk '{print $1}')"

            # ensure user has a store set up
            if [[ ! -d "$msdir" ]]; then
                echo "Skipping $user, they don't have a store set up."
                continue
            elif [[ -d "$msdir" ]] && ! findmnt "$msdir/store" >/dev/null; then
                echo "User $user has an existing store, but store isnt mounted."
                echo "Removing store for user $user."
                rm -rf "$msdir"
                continue
            fi

            # gracefully kill processes accessing the store
            lsof -t "$msdir/store" | xargs kill -15

            # unount store and lockfiles
            umount -Rf "$msdir/store"

            # destroy the store
            rm -rf "$msdir/store"
        done
        ;;
        
    *)
        echo "Unrecognized parameter $1."
        exit 1
        ;;
esac
