#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ $* != *--lockfile=* ]] || [[ $* != *--hash=* ]]; then
    echo "[!!!] Arguments --lockfile or --hash were not used."
    echo "[---] Usage: $0 --lockfile=/PATH/TO/LOCKFILE.lock --hash=HASH"
    exit 64
elif [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

# set constants
FAILED=0

# parse arguments
for arg in "$@"; do
    case $arg in
        --lockfile=*)
            LOCKFILE="${arg#*=}"
            RFSDIR=$(dirname "$LOCKFILE")
            readonly LOCKFILE
            readonly RFSDIR
            ;;

        --hash=*)
            HASH="${arg#*=}"
            readonly HASH
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# utilities
start-subsystem() {
    if ! podman container exists "subsystem-$HASH"; then
        podman container create \
            --init \
            --cgroups=split \
            --name "subsystem-$HASH" \
            --hostname subsystem \
            --log-driver journald \
            --env "SUBSYSTEM_USER=$USER" \
            --network host \
            --user 0:0 \
            --userns keep-id \
            --tmpfs /run \
            --workdir "/home/$USER" \
            -v "$HOME":"/home/$USER":rslave \
            -v /tmp:/tmp:rslave,nosuid,nodev,rbind \
            -v /run/user/"$UID":/run/user/"$UID":ro,rslave \
            -v /usr/lib/subsystem/bin/ignition:/usr/libexec/ignition:ro \
            -v /usr/lib/subsystem/bin/synergy:/usr/bin/synergy:ro \
            --rootfs "$RFSDIR"/root:O \
            /usr/libexec/ignition
    fi

    podman container start "subsystem-$HASH"
}

# set traps
trap 'echo "[!!!] Received SIGTERM." && exit 1' SIGTERM

# watch subsystem container based on lockfile presence
echo "[---] Monitoring subsystem-$HASH."

while [[ -f $LOCKFILE ]]; do
    while podman ps --filter "name=subsystem-$HASH" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$HASH$"; do
        sleep 1
    done

    [[ -f $LOCKFILE ]] || break

    echo "[i] subsystem-$HASH exited, restarting..."

    if ! start-subsystem; then
        FAILED=$(( FAILED + 1 ))
        echo "[!!] Failed to restart subsystem-$HASH, failure counter is at $FAILED."
    else
        sleep 1
        if ! podman ps --filter "name=subsystem-$HASH" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$HASH$"; then
            FAILED=$(( FAILED + 1 ))
            echo "[!!] Failed to start subsystem-$HASH, failure counter is at $FAILED."
        else
            FAILED=0
            echo "[i] Restarted subsystem-$HASH successfully."
        fi
    fi

    if [[ "$FAILED" -ge "5" ]]; then
        echo "[!!!] Reached 5 or more consecutive failed restarts."
        exit 1
    fi
done

exit 0