#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# do our checks
if [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

# logging
echo "[---] Starting up."

# set up sudo for the user
echo "[1/5] Configuring sudo."
if [[ ! -f /etc/sudoers.d/nopasswd-for-subsystem ]]; then
    mkdir -p /etc/sudoers.d
	echo "$SUBSYSTEM_USER ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/nopasswd-for-subsystem
fi

# add shell settings
echo "[2/5] Configuring shell."
mkdir -p /etc/fish/conf.d
cat <<EOF >> /etc/fish/conf.d/startup.fish
alias fastfetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"
alias neofetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"
alias hyfetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"

function fish_greeting
    if not test -e ~/.config/subsystem/suppress-notice
        echo "Welcome! You are inside a mutable, host-based container whose default shell is fish."
        echo "All system changes besides those to your home directory reset on system reboot/shutdown."
        echo "Also note that some commands may have undefined behavior, so be cautious."
        echo
        echo "Run 'subsys help' to see some useful commands for managing this container."
        echo "Run 'synergy --help' to see how to manage host command execution/linking."
        echo
        echo "Linked commands: distrobox, podman, flatpak, niri, noctalia, systemctl, journalctl, bootc"
        echo "Brew is also accessible, just not directly in the container. Just run: synergy brew [...]"
        echo
        echo "To hide this lovely notice, run: touch ~/.config/subsystem/suppress-notice"
    end
end

if status is-interactive
    atuin init fish | source
end
EOF

# link default commands
echo "[3/5] Linking default commands."
for cmd in "$(command -v distrobox)"{,-*} podman flatpak niri noctalia systemctl journalctl; do CMDPATH=$(command -v "$cmd"); rm -f "$CMDPATH"; ln -sT /usr/libexec/host-spawn "$CMDPATH"; done

# link bootc
rm -f /usr/bin/bootc
echo -e '#!/bin/bash\n/usr/libexec/host-spawn pkexec /usr/bin/bootc $@' | tee -a /usr/bin/bootc
chmod +x /usr/bin/bootc

# source user configs
echo "[4/5] Sourcing user configurations."
if [[ -d /home/"$SUBSYSTEM_USER"/.config/ignition.d/ ]]; then
	for script in /home/"$SUBSYSTEM_USER"/.config/ignition.d/*.sh; do
		echo "[i] Sourcing script $script."
		. "$script" || true
	done
fi

# attempt to configure fastest arch repos
echo "[5/5] Configuring repositories."
reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist >/dev/null 2>&1 || true

# keep subsystem alive
echo "[---] Startup done."
sleep infinity
