#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ $* != *--lockfile=* ]] || [[ $* != *--subsysid=* ]]; then
    echo "[!!!] Arguments --lockfile or --subsysid were not used."
    echo "[---] Usage: $0 --lockfile=/PATH/TO/LOCKFILE.lock --subsysid=ID"
    exit 64
elif [[ "$EUID" == "0" ]]; then
    echo "[!!!] Please do not run this as an administrator."
    exit 77
fi

# parse arguments
for arg in "$@"; do
    case $arg in
        --lockfile=*)
            LOCKFILE="${arg#*=}"
            MSDIR=$(dirname "$LOCKFILE")
            readonly LOCKFILE
            readonly MSDIR
            ;;

        --subsysid=*)
            SUBSYS_ID="${arg#*=}"
            readonly SUBSYS_ID
            ;;

        *)
            echo "[i] Argument $arg not known, ignoring."
            ;;
    esac
done

# set constants
USER_UID=$(id -u)
FAILED=0

# utilities
startctr() {
    podman container run \
        --init \
        --rm \
        --detach \
        --cgroups=split \
        --env-host \
        --name "subsystem-$SUBSYS_ID" \
        --hostname subsystem \
        --log-driver journald \
        --env "SUBSYSTEM_USER=$USER" \
        --env "GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas" \
        --network host \
        --user 0:0 \
        --userns keep-id \
        --tmpfs /tmp \
        --tmpfs /run \
        --workdir "$HOME" \
        -v "$HOME":"$HOME":rslave \
        -v "/run/user/$USER_UID":"/run/user/$USER_UID":ro,rslave \
        -v /usr/lib/subsystem/bin/ignition:/usr/libexec/ignition:ro \
        -v /usr/lib/subsystem/bin/synergy:/usr/bin/synergy:ro \
        --rootfs "$MSDIR/rootfs" \
        /usr/libexec/ignition
}

# watch subsystem container based on lockfile presence
echo "[---] Monitoring subsystem-$SUBSYS_ID."

while [[ -f $LOCKFILE ]]; do
    while podman ps --filter "name=subsystem-$SUBSYS_ID" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$SUBSYS_ID$"; do
        sleep 1
    done

    [[ -f $LOCKFILE ]] || break

    echo "[i] subsystem-$SUBSYS_ID exited, restarting."

    if ! startctr; then
        FAILED=$(( FAILED + 1 ))
        echo "[!] Failed to restart subsystem-$SUBSYS_ID, failure counter is at $FAILED."
    else
        if ! podman ps --filter "name=subsystem-$SUBSYS_ID" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$SUBSYS_ID$"; then
            FAILED=$(( FAILED + 1 ))
            echo "[!] Failed to start subsystem-$SUBSYS_ID, failure counter is at $FAILED."
        else
            FAILED=0
            echo "[i] Restarted subsystem-$SUBSYS_ID successfully."
        fi
    fi

    if [[ "$FAILED" -ge "5" ]]; then
        echo "[!!!] Reached 5 or more consecutive failed restarts."
        exit 1
    fi
done

exit 0