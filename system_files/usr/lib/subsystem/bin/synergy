#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

# utilities
help() {
    cat <<EOF
usage:
    synergy [options...] <command>

synopsis:
    execute, link, or unlink commands from the host system

options:
    -h, --help                      show this help message
    -l, --link                      link <command> from the host
    -u, --unlink                    unlink <command> linked from the host    
    -r, --root                      execute <command> as root, requires user authentication    

unrecognized options will be treated as a string to execute on the host within a seperate bash shell, e.g. "echo foo"
bash scripting is supported, e.g. "synergy [[ -f /some/file ]] && echo 'successful'"
EOF
}

# iterate through args
case $1 in
    -h|--help)
        # help msg
        help
        ;;
    -l|--link)
        # shift args
        shift

        # run checks
        if [[ -z "$1" ]]; then
            echo "[!!!] No command to link provided."
            help
            exit 1
        elif ! /usr/libexec/host-spawn command -v "$1" >/dev/null; then
            echo "[!!!] Command $1 not found."
            exit 1
        elif [[ $(realpath /usr/bin/"$1") == /usr/libexec/host-spawn ]]; then
            echo "[!!!] Command $1 is already linked."
            exit 1
        elif command -v "$1" >/dev/null 2>&1; then
            echo "[!!!] Command $1 already exists."
            exit 1
        fi

        # link command
        echo "[1/1] Linking command $1..."
        sudo ln -sT /usr/libexec/host-spawn /usr/local/bin/"$1"
        echo "[1/1] Linked command $1 to /usr/local/bin/$1"
        ;;
    -u|--unlink)
        # shift args
        shift

        # run checks
        if [[ -z "$1" ]]; then
            echo "[!!!] No command to unlink provided."
            help
            exit 1
        elif [[ $(realpath /usr/local/bin/"$1") != /usr/libexec/host-spawn ]]; then
            echo "[!!!] Command $1 isn't linked."
            exit 1
        fi

        # unlink command
        echo "[1/1] Unlinking command $1..."
        sudo rm -f /usr/local/bin/"$1"
        echo "[1/1] Unlinked command $1"
        ;;
    -r|--root)
        # shift args
        shift

        # check if a command was provided
        if [[ -z "$*" ]]; then
            help
            echo "[!!!] No command provided."
            exit 1
        fi
    
        # execute cmd as root
        /usr/libexec/host-spawn --no-pty pkexec env SUBSYSTEM_USER=bypass bash -lic "$@"
        ;;
    *)
        # run checks
        if [[ -z "$*" ]]; then
            echo "[!!!] No command provided."
            help
            exit 1
        fi

        # execute cmd normally
        /usr/libexec/host-spawn --no-pty env SUBSYSTEM_USER=bypass bash -lic "$@"
        ;;
esac