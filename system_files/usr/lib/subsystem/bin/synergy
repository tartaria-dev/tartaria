#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

### set errexit & pipefail
set -eo pipefail

### do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

### help msg

help() {
    cat <<EOF
usage:
    synergy [options...] <command>

synopsis:
    execute, link, or unlink commands from the host system

options:
    -h, --help                      show this help message
    -l, --link <command>            link <command> from the host
    -u, --unlink <command>          unlink <command> linked from the host
    -r, --root <command>            execute <command> on the host as root, requires user authentication
    <command>                       execute <command> on the host

EOF
}

### command actions

link_cmd() {
    shift

    if [[ -z "$1" ]]; then
        echo "[!!!] No command to link provided."
        help
        exit 1
    elif ! host-spawn command -v "$1" >/dev/null; then
        echo "[!!!] Command $1 not found."
        exit 1
    elif [[ $(realpath /usr/bin/"$1") == /usr/local/bin/host-spawn ]]; then
        echo "[!!!] Command $1 is already linked."
        exit 1
    elif command -v "$1" >/dev/null 2>&1; then
        echo "[!!!] Command $1 already exists."
        exit 1
    fi

    echo "[1/1] Linking command $1..."
    sudo ln -sT /usr/local/bin/host-spawn /usr/local/bin/"$1"

    echo "[1/1] Linked command $1 to /usr/local/bin/$1"
}

unlink_cmd() {
    shift

    if [[ -z "$1" ]]; then
        echo "[!!!] No command to unlink provided."
        help
        exit 1
    elif [[ $(realpath /usr/local/bin/"$1") != /usr/local/bin/host-spawn ]]; then
        echo "[!!!] Command $1 isn't linked."
        exit 1
    fi

    echo "[1/1] Unlinking command $1..."
    sudo rm -f /usr/local/bin/"$1"

    echo "[1/1] Unlinked command $1"
}

### cmd execution

exec_root() {
    shift

    if [[ -z "$*" ]]; then
        help
        echo "[!!!] No command provided."
        exit 1
    fi

    host-spawn run0 --background= env SUBSYSTEM_BYPASS=1 bash -lic "$*"
}

exec_norm() {
    if [[ -z "$*" ]]; then
        echo "[!!!] No command provided."
        help
        exit 1
    fi

    host-spawn env SUBSYSTEM_BYPASS=1 bash -lic "$*"
}

### main logic

main() {
    case $1 in
        -h|--help)
            help
            ;;
        -l|--link)
            link_cmd "$@"
            ;;
        -u|--unlink)
            unlink_cmd "$@"
            ;;
        -r|--root)
            exec_root "$@"
            ;;
        *)
            exec_norm "$@"
            ;;
    esac
}

main
