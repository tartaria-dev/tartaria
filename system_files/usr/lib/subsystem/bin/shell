#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

### do our checks

if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

### constants

NORM=$(tput sgr0)
GRAY=$(tput setaf 7)
RED=$(tput setaf 1)
HASH=$(printf '%s%s' "$(</etc/machine-id)" "$USER" | sha256sum | awk '{print $1}')

readonly RED GRAY NORM HASH

### utilities

util_getstate() {
    systemctl --user is-failed subsystem-containerd 2>/dev/null
}

util_throbber() {
    local msg="$1"
    local frames=("/" "-" "\\" "|")

    for frame in "${frames[@]}"; do
        printf "\r[%s] %s" "$frame" "$msg"
        sleep 0.25
    done
}

### error msgs

emsg_entry() {
    clear
    cat <<EOF
${RED}Oops,

Something went wrong while trying to enter your subsystem.
Logs containing relevant information can be viewed with the following command:${NORM}

${GRAY}journalctl --user -xeu subsystem-containerd${NORM}

${RED}Manual intervention/debugging may be required.
Falling back to host shell...${NORM}

EOF
}

emsg_sfail() {
    clear
    cat <<EOF
${RED}Oops,

Your subsystem has failed to start.
Logs containing relevant information can be viewed with the following command:${NORM}

${GRAY}journalctl --user -xeu subsystem-containerd${NORM}

${RED}Manual intervention/debugging may be required.
Falling back to host shell...${NORM}

EOF
}

### shell logic

shell() {
    local try_counter=0
    
    rm -f "$HOME"/.cache/subsys-restart
    
    while [[ "$try_counter" -lt "10" ]]; do
        if distrobox-enter "subsystem-$HASH" -- /bin/fish -l; then
            exit 0
        elif [[ -f "$HOME/.cache/subsys-restart" ]]; then
            clear
            exec env TMSG="Restarting..." /usr/lib/subsystem/bin/shell
        else
            try_counter=$(( "$try_counter" + 1 ))
        fi
    done

    emsg_entry

    exec env SUBSYSTEM_BYPASS=1 bash -l
}

## main logic

main() {
    local waited_seconds=0
    
    if [[ "$(util_getstate)" == "active" ]]; then
        shell
    elif [[ "$(util_getstate)" == "activating" || "$(util_getstate)" == "deactivating" || "$(util_getstate)" == "reloading" || "$(util_getstate)" == inactive ]]; then
        while [[ "$(util_getstate)" == "activating" || "$(util_getstate)" == "deactivating" || "$(util_getstate)" == "reloading" || "$(util_getstate)" == inactive ]]; do
            util_throbber ${TMSG:-Starting...}
            
            waited_seconds=$(( "waited_seconds" + 1 ))
    
            if [[ "$waited_seconds" -gt "30" ]]; then
                emsg_entry
                exec env SUBSYSTEM_BYPASS=1 bash -l
            fi
        done
    
        if [[ "$(util_getstate)" == "active" ]]; then
            shell
        else
            emsg_sfail
            exec env SUBSYSTEM_BYPASS=1 bash -l
        fi
    else
        emsg_sfail
        exec env SUBSYSTEM_BYPASS=1 bash -l
    fi
}

main
