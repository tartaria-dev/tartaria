set -e

# constants
MSDIR="/tmp/subsystem-$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')"
SUBSYS_ID=$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')
USER_UID=$(id -u)
readonly SUBSYS_ID
readonly USER_UID
readonly MSDIR

# ensure we have sufficient args
if [[ -z $1 ]]; then
    echo "Insufficient parameters."
    exit 1
fi

# ensure we aren't root
if [[ "$EUID" == "0" ]]; then
    echo "Please do not run this as an administrator."
    exit 1
fi

# ensure store management has started
if [[ "$(systemctl is-failed subsystem-stores)" != "active" ]]; then
    echo "Store management has failed/is inactive, abort."
    exit 1  
elif [[ ! -d "$MSDIR" ]]; then
    echo "We do not have a configured subsystem store, abort."
    exit 1
elif ! findmnt "$MSDIR/store" >/dev/null; then
    echo "Our subsystem store isn't properly mounted, abort."
    exit 1
fi

# iterate through args
case $1 in
    configure)
        # setup storage config if needed
        if [[ ! -f "$HOME/.config/containers/storage.conf" ]]; then
            echo "Creating storage config."
            cp -f /usr/lib/subsystem/defaults/storage.conf "$HOME/.config/containers/storage.conf"
            sed -i "s/PLACEHOLDER/$MSDIR/g" "$HOME/.config/containers/storage.conf"
        elif [[ -f "$HOME/.config/containers/storage.conf" ]] && ! grep -q "$MSDIR/store" "$HOME/.config/containers/storage.conf"; then
            echo "Replacing storage config."
            mv "$HOME/.config/containers/storage.conf" "$HOME/.config/containers/storage.conf.bk"
            cp -f /usr/lib/subsystem/defaults/storage.conf "$HOME/.config/containers/storage.conf"
            sed -i "s/PLACEHOLDER/$MSDIR/g" "$HOME/.config/containers/storage.conf"
        else
            echo "Nothing to do, subsystem already configured."
        fi
        ;;

    start)
        # if subsystem doesn't exist, create it, otherwise, start it
        if ! podman ps -a | grep -q "subsystem-$SUBSYS_ID"; then
            echo "Starting subsystem."
            podman run --name "subsystem-$SUBSYS_ID" --log-driver journald --detach --cgroups=split --workdir "$HOME" --hostname subsystem --env-host --env "SUBSYSTEM_USER=$USER" --network host --user 0:0 --userns keep-id -v "$HOME":"$HOME":rslave -v "/run/USER/$USER_UID":"/run/USER/$USER_UID":ro,rslave subsystem:latest /usr/libexec/subsystem-init
            echo "Started subsystem."
            echo "Blocking until subsystem exit."
            podman wait "subsystem-$SUBSYS_ID"
        elif ! podman ps | grep -q "subsystem-$SUBSYS_ID"; then
            echo "Starting subsystem."
            podman start "subsystem-$SUBSYS_ID"
            echo "Started subsystem."
            echo "Blocking until subsystem exit."
            podman wait "subsystem-$SUBSYS_ID"
        else
            echo "Nothing to do, subsystem already started."
        fi
        ;;

    stop)
        # if subsystem isn't already stopped, stop it
        if podman ps | grep -q "subsystem-$SUBSYS_ID"; then
            echo "Stopping subsystem."
            podman stop -t 5 "subsystem-$SUBSYS_ID"
            echo "Stopped subsystem."
        else
            echo "Nothing to do, subsystem already stopped."
        fi
        ;;

    *)
        echo "Unrecognized parameter $1."
        exit 1
        ;;
esac