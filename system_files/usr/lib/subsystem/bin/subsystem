#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ -z $1 ]]; then
    echo "[!!!] Insufficient parameters."
    echo "[---] Usage: $0 start|stop"
    exit 64
elif [[ "$EUID" == "0" ]]; then
    echo "[!!!] Please do not run this as an administrator."
    exit 77
elif ! grep -q "$USER" /etc/subuid || ! grep -q "$USER" /etc/subgid; then
    echo "[!!!] $USER does not have sub{uid,gid}s configured."
    exit 78
elif [[ -z $PODMAN_SYSTEMD_UNIT ]] || [[ -z $NOTIFY_SOCKET ]]; then
    echo "[!!!] Environment isn't properly set up."
    exit 71
fi

# set constants
MSDIR="$HOME/.local/share/subsystem"
SUBSYS_ID=$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')
USER_UID=$(id -u)
readonly MSDIR
readonly SUBSYS_ID
readonly USER_UID
export NOTIFY_SOCKET

# iterate through args
case $1 in
    start)
        # trap EXIT
        trap 'echo "[!!!] Error occurred, cleaning up." && /usr/lib/subsystem/bin/subsystem stop' EXIT

        # ensure all subsystem dirs/configs exist
        systemd-notify --status="Preparing..."
        echo "[1/4] Preparing..."
        echo "[---] Creating directories."
        mkdir -p "$MSDIR"/{rootfs,basefs,fsdata,.work}
        mkdir -p "$HOME"/.config/subsystem
        echo "[1/4] Preparation done."

        # clean mountpoints and mount subsystem root
        systemd-notify --status="Mounting susbsytem root..."
        echo "[2/4] Mounting subsystem root..."
        pkexec /usr/lib/subsystem/bin/filesystem mount --store="$MSDIR" --user="$USER"
        echo "[2/4] Mounted subsystem root."

        # start subsystem
        systemd-notify --status="Starting subsystem..."
        echo "[3/4] Starting subsystem..."
        podman container rm -ifv "subsystem-$SUBSYS_ID"
        podman container run \
            --init \
            --rm \
            --detach \
            --cgroups=split \
            --env-host \
            --name "subsystem-$SUBSYS_ID" \
            --hostname subsystem \
            --log-driver journald \
            --env "SUBSYSTEM_USER=$USER" \
            --env "container=subsystem" \
            --network host \
            --user 0:0 \
            --userns keep-id \
            --tmpfs /tmp \
            --tmpfs /run \
            --workdir "$HOME" \
            -v "$HOME":"$HOME":rslave \
            -v "/run/user/$USER_UID":"/run/user/$USER_UID":ro,rslave \
            --rootfs "$MSDIR/rootfs" \
            /usr/libexec/ignition
        echo "[3/4] Started subsystem."

        # dispatch restart helper
        systemd-notify --ready --status="Monitoring subsystem..."
        echo "[4/4] Dispatching restart helper."
        touch "$MSDIR"/.keepalive.lock
        systemd-cat /usr/lib/subsystem/bin/restart-helper --lockfile="$MSDIR/.keepalive.lock" --subsysid="$SUBSYS_ID"

        # reset traps
        trap - EXIT
        ;;

    stop)
        # trap failure incase stopping fails
        trap 'echo "[!!!] Stop process failed. Manual intervention may be required."' EXIT

        # stop subsystem
        systemd-notify --stopping --status="Stopping subsystem..."
        echo "[1/2] Stopping subsystem..."
        rm -f "$MSDIR"/.keepalive.lock
        podman container stop -it 30 "subsystem-$SUBSYS_ID"
        podman container rm -ifv "subsystem-$SUBSYS_ID"
        echo "[1/2] Stopped subsystem."

        # unmount subsystem root
        systemd-notify --status="Unmounting subsystem root..."
        echo "[2/2] Unmounting subsystem root..."
        pkexec /usr/lib/subsystem/bin/filesystem unmount --store="$MSDIR" --user="$USER"
        echo "[2/2] Unmounted subsystem root."

        # reset trap
        trap - EXIT
        ;;

    *)
        # you fool! you didn't pass the correct argument, dammit! you utter fool!
        echo "[!!!] Unrecognized argument $1."
        echo "[i] Usage: $0 start|stop"
        exit 64
        ;;
esac

exit 0