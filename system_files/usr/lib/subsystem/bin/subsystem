#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ -z $1 ]]; then
    echo "[!!!] Insufficient parameters."
    echo "[---] Usage: $0 start|stop"
    exit 64
elif [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
elif ! grep -q "$USER" /etc/subuid || ! grep -q "$USER" /etc/subgid; then
    echo "[!!!] $USER does not have sub{uid,gid}s configured."
    exit 78
elif [[ -z $PODMAN_SYSTEMD_UNIT ]]; then
    echo "[!!!] Environment isn't properly set up."
    exit 71
fi

# set constants
HASH=$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')
RFSDIR="/tmp/subsystem-$HASH"
readonly HASH
readonly RFSDIR

# utilities
start-subsystem() {
    if ! podman container exists "subsystem-$HASH"; then
        podman container create \
            --init \
            --cgroups=split \
            --name "subsystem-$HASH" \
            --hostname subsystem \
            --log-driver journald \
            --env "SUBSYSTEM_USER=$USER" \
            --network host \
            --user 0:0 \
            --userns keep-id \
            --tmpfs /run \
            --workdir "/home/$USER" \
            -v "$HOME":"/home/$USER":rslave \
            -v /tmp:/tmp:rslave,nosuid,nodev,rbind \
            -v /run/user/"$UID":/run/user/"$UID":ro,rslave \
            -v /usr/lib/subsystem/bin/ignition:/usr/libexec/ignition:ro \
            -v /usr/lib/subsystem/bin/synergy:/usr/bin/synergy:ro \
            --rootfs /var/lib/subsystem/content/"$HASH":O \
            /usr/libexec/ignition
    fi

    podman container start "subsystem-$HASH"
}

# iterate through args
case $1 in
    start)
        # trap EXIT
        trap 'echo "[!!!] Error occurred, cleaning up." && /usr/lib/subsystem/bin/subsystem stop' EXIT

        # mount subsystem root
        echo "[1/3] Mounting subsystem root..."
        pkexec /usr/lib/subsystem/bin/filesystem mount --user="$USER" --hash="$HASH" --rfsdir="$RFSDIR" | cat
        echo "[1/3] Mounted subsystem root."

        # start subsystem
        echo "[2/3] Starting subsystem..."
        mkdir -p "$HOME"/.config/subsystem
        start-subsystem
        echo "[2/3] Started subsystem."

        # dispatch helper
        echo "[3/3] Dispatching helper."
        touch "$RFSDIR"/runtime.lock
        /usr/lib/subsystem/bin/helper --lockfile="$RFSDIR/runtime.lock" --hash="$HASH" | cat

        # reset traps
        trap - EXIT
        ;;

    stop)
        # trap failure incase stopping fails
        trap 'echo "[!!!] Stop process failed. Manual intervention may be required."' EXIT

        # stop subsystem
        echo "[1/2] Stopping subsystem..."
        rm -f "$RFSDIR"/runtime.lock
        podman container stop -it 30 "subsystem-$HASH"
        echo "[1/2] Stopped subsystem."

        # unmount subsystem root
        echo "[2/2] Unmounting subsystem root..."
        pkexec /usr/lib/subsystem/bin/filesystem unmount --user="$USER" --hash="$HASH" --rfsdir="$RFSDIR" | cat
        echo "[2/2] Unmounted subsystem root."

        # reset trap
        trap - EXIT
        ;;

    *)
        # you fool! you didn't pass the correct argument, dammit! you utter fool!
        echo "[!!!] Unrecognized argument $1."
        echo "[---] Usage: $0 start|stop"
        exit 64
        ;;
esac

exit 0
