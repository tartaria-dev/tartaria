#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

## set errexit, pipefail, errtrace
set -eEo pipefail

## do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

## set constants
HASH=$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')
RTMEDIR="$HOME/.cache/subsystem-$HASH"
readonly HASH
readonly RTMEDIR

## create conf dir if needed
mkdir -p "$HOME"/.config/subsystem

## utilities
start-subsystem() {
    # trap ERR, SIGTERM
    trap 'echo "[!!!] Something went wrong during startup, aborting." && return 1' ERR
    trap 'echo "[!!!] Received SIGTERM, aborting." && return 0' SIGTERM

    # check if filesystemd is still starting; if so, wait
    if [[ "$(systemctl --user is-failed subsystem-filesystemd)" == "activating" ]]; then
        echo "[-i-] subsystem-filesystemd has not finished startup, waiting."

        while [[ "$(systemctl --user is-failed subsystem-filesystemd)" == "activating" ]]; do
            sleep 1
        done
        
        if [[ "$(systemctl --user is-failed subsystem-filesystemd)" != "active" ]]; then
            echo "[!!!] subsystem-filesystemd has failed to start."
        fi
    fi

    # logging
    echo "[---] Starting subsystem."

    # start container
    echo "[1/2] Starting container."
    podman-cmd

    # set runtime lock
    echo "[2/2] Creating runtime lock."
    mkdir -p "$RTMEDIR"
    touch "$RTMEDIR"/runtime.lock

    # reset traps
    trap - ERR SIGTERM
}

stop-subsystem() {
    # trap ERR, SIGTERM
    trap 'echo "[!!!] Something went wrong during shutdown, aborting." && return 1' ERR
    trap 'echo "[!!!] Received SIGTERM, aborting." && return 0' SIGTERM

    # logging
    echo "[---] Stopping subsystem."

    # clear runtime lock
    echo "[1/2] Removing runtime lock."
    rm -rf "$RTMEDIR"

    # stop container
    echo "[2/2] Stopping container."
    podman container stop -it 30 "subsystem-$HASH"
    podman container rm -if "subsystem-$HASH"

    # reset traps
    trap - ERR SIGTERM
}

monitor() (
    # block if subsystem is running
    if podman ps --filter "name=subsystem-$HASH" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$HASH$"; then
        podman wait "subsystem-$HASH" &
        local WAIT_PID=$!
        wait "$WAIT_PID"
        echo "[-i-] Subsystem exited with code $?."
    fi
)

podman-cmd() {
    # remove container if it exists
    if podman container exists "subsystem-$HASH"; then
        podman container rm -if "subsystem-$HASH"
    fi

    # create and start container
    podman container run \
        --init \
        --detach \
        --hostname "$HOSTNAME" \
        --name "subsystem-$HASH" \
        --privileged \
        --security-opt label=disable \
        --security-opt apparmor=unconfined \
        --pids-limit=-1 \
        --user root:root \
        --ipc host \
        --network host \
        --log-driver journald \
        --label "manager=distrobox" \
        --label "distrobox.unshare_groups=1" \
        --env "SHELL=fish" \
        --env "HOME=$HOME" \
        --env "LANG=$LANG" \
        --env "container=podman" \
        --env "TERMINFO_DIRS=/usr/share/terminfo:/run/host/usr/share/terminfo" \
        --env "CONTAINER_ID=subsystem-$HASH" \
        --volume /tmp:/tmp:rslave \
        --volume /usr/bin/distrobox-init:/usr/bin/entrypoint:ro \
        --volume /usr/lib/subsystem/bin/host-spawn:/usr/local/bin/host-spawn:ro \
        --volume /usr/lib/subsystem/bin/synergy:/usr/local/bin/synergy:ro \
        --volume /usr/lib/subsystem/bin/subsys:/usr/local/bin/subsys:ro \
        --volume /run/user/"$(id -u)":/run/user/"$(id -u)":rslave \
        --volume "$HOME":"$HOME":rslave \
        --volume /:/run/host/:rslave \
        --volume /dev:/dev:rslave \
        --volume /sys:/sys:rslave \
        --volume /var/log/journal \
        --volume /etc/hosts:/etc/hosts:ro \
        --volume /etc/resolv.conf:/etc/resolv.conf:ro \
        --volume /etc/hostname:/etc/hostname:ro \
        --volume /dev/null:/run/.distrobox.rootless:ro \
        --volume /dev/null:/usr/share/dbus-1/services/org.freedesktop.Flatpak.service \
        --runtime=crun \
        --annotation run.oci.keep_original_groups=1 \
        --ulimit host \
        --restart=always \
        --userns keep-id:size=65536 \
        --entrypoint /usr/bin/entrypoint \
        --rootfs /var/lib/subsystem/"$HASH"/rootfs \
        --name "$USER" \
        --user "$(id -u)" \
        --group "$(id -g)" \
        --home "$HOME" \
        --init "0" \
        --nvidia "0" \
        --pre-init-hooks "" \
        --additional-packages "" \
        -- '/usr/lib/subsystem/bin/ignition'
}

## main logic
systemd-notify --status "Starting..."
echo "[-+-] Starting up."
start-subsystem

systemd-notify --ready --status "Subsystem is running."
monitor

systemd-notify --status "Stopping..."
echo "[-+-] Shutting down."
stop-subsystem

systemd-notify --status "Stopped."
