#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

### set errexit + errtrace + nounset + pipefail

set -eEuo pipefail

### do our checks

if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

### set SIGTERM trap

trap 'echo "[-i-] Received SIGTERM, shutting down."; shutdown=1; kill "$watch_pid" 2>/dev/null || true' SIGTERM

### set global vars

watch_pid=
shutdown=0

### set constants

HASH=$(printf '%s%s' "$(</etc/machine-id)" "$USER" | sha256sum | awk '{print $1}')
RTME_DIR="$HOME/.cache/subsystem-$HASH"

readonly HASH RTME_DIR

### subsystem stuff

subsys_start() {
    trap 'echo "[!!!] Something went wrong during startup, aborting."; return 1' ERR

    if [[ "$(systemctl is-failed subsystem-filesystemd)" == "activating" ]]; then
        echo "[-i-] Filesystem daemon has not finished startup, waiting."

        while [[ "$(systemctl is-failed subsystem-filesystemd)" == "activating" ]]; do
            sleep 1
        done
        
        if [[ "$(systemctl is-failed subsystem-filesystemd)" != "active" ]]; then
            echo "[!!!] Filesystem daemon has failed to start."
            false
        fi
    fi

    mkdir -p "$HOME"/.config/subsystem

    echo "[---] Starting subsystem..."

    if (( shutdown )); then return; fi

    echo "[1/3] Mounting rootfs."

    key=$(<"/run/subsystem-filesystemd/auth/$USER")
    resp=$(echo "$key-mount-$USER" | socat -t120 -T120 - UNIX-CONNECT:/run/subsystem-filesystemd/fsrequests.sock)

    if [[ "$resp" != "mounted" ]]; then
        echo "[!!!] Mount request failed, received response '$resp'"
        false
    fi

    if (( shutdown )); then return; fi

    echo "[2/3] Starting container."
    
    subsys_cmd

    if (( shutdown )); then return; fi

    echo "[3/3] Creating runtime lock."
    
    mkdir -p "$RTME_DIR"
    touch "$RTME_DIR"/runtime.lock

    echo "[---] Started subsystem."

    trap - ERR
}

subsys_stop() {
    trap 'echo "[!!!] Something went wrong during shutdown, aborting."; return 1' ERR

    echo "[---] Stopping subsystem..."

    echo "[1/3] Removing runtime lock."
    
    rm -rf "$RTME_DIR"

    echo "[2/3] Stopping container."
    
    podman container stop -it 30 "subsystem-$HASH"
    podman container rm -if "subsystem-$HASH" >/dev/null

    echo "[3/3] Unmounting rootfs."
    
    key=$(<"/run/subsystem-filesystemd/auth/$USER")
    resp=$(echo "$key-unmount-$USER" | socat -t120 -T120 - UNIX-CONNECT:/run/subsystem-filesystemd/fsrequests.sock)

    if [[ "$resp" != "unmounted" ]]; then
        echo "[!!!] Unmount request failed, received response '$resp'"
        false
    fi

    echo "[---] Stopped subsystem."

    trap - ERR
}

subsys_cmd() {
    if podman container exists "subsystem-$HASH"; then
        podman container rm -if "subsystem-$HASH"
    fi

    podman container run \
        --init \
        --detach \
        --hostname "$HOSTNAME" \
        --name "subsystem-$HASH" \
        --privileged \
        --security-opt label=disable \
        --security-opt apparmor=unconfined \
        --pids-limit=-1 \
        --user root:root \
        --ipc host \
        --network host \
        --log-driver journald \
        --label "manager=distrobox" \
        --label "distrobox.unshare_groups=1" \
        --env "SHELL=fish" \
        --env "HOME=$HOME" \
        --env "LANG=$LANG" \
        --env "container=podman" \
        --env "TERMINFO_DIRS=/usr/share/terminfo:/run/host/usr/share/terminfo" \
        --env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus" \
        --env "CONTAINER_ID=subsystem-$HASH" \
        --volume /tmp:/tmp:rslave \
        --volume /usr/bin/distrobox-init:/usr/bin/entrypoint:ro \
        --volume /usr/lib/subsystem/bin/host-spawn:/usr/local/bin/host-spawn:ro \
        --volume /usr/lib/subsystem/bin/synergy:/usr/local/bin/synergy:ro \
        --volume /usr/lib/subsystem/bin/subsys:/usr/local/bin/subsys:ro \
        --volume /run/user/"$(id -u)":/run/user/"$(id -u)":rslave \
        --volume "$HOME":"$HOME":rslave \
        --volume /:/run/host/:rslave \
        --volume /dev:/dev:rslave \
        --volume /sys:/sys:rslave \
        --volume /var/log/journal \
        --volume /etc/hosts:/etc/hosts:ro \
        --volume /etc/resolv.conf:/etc/resolv.conf:ro \
        --volume /etc/hostname:/etc/hostname:ro \
        --volume /dev/null:/run/.distrobox.rootless:ro \
        --volume /dev/null:/.containersetupdone:ro \
        --runtime=crun \
        --annotation run.oci.keep_original_groups=1 \
        --ulimit host \
        --userns keep-id:size=65536 \
        --entrypoint /usr/bin/entrypoint \
        --rootfs /var/lib/subsystem/"$HASH"/rootfs \
        --name "$USER" \
        --user "$(id -u)" \
        --group "$(id -g)" \
        --home "$HOME" \
        --init "0" \
        --nvidia "0" \
        --pre-init-hooks "" \
        --additional-packages "" \
        -- '/usr/lib/subsystem/bin/ignition' >/dev/null

    while ! grep -q '^container_setup_done' <<< "$(podman logs "subsystem-$HASH" 2>&1)"; do
        if (( shutdown )); then return 0; fi

        if [[ "$(podman container inspect -f '{{.State.Running}}' "subsystem-$HASH" 2>/dev/null)" != "true" ]]; then
            echo "[!!!] Container exited during startup."
            false
        fi

        sleep 1
    done
}

### monitoring

monitor() {
    local code

    while (( ! shutdown )); do
        if podman ps --filter "name=subsystem-$HASH" --filter "status=running" --format "{{.Names}}" | grep -q "^subsystem-$HASH$"; then
            podman wait "subsystem-$HASH" >/dev/null &
            watch_pid=$!
            wait "$watch_pid" || true
            watch_pid=

            if (( shutdown )); then
                break
            fi

            code=$(podman container inspect --format '{{.State.ExitCode}}' "subsystem-$HASH" 2>/dev/null) || code="unknown"
            echo "[-i-] Subsystem exited with code $code, restarting."
        fi

        if (( shutdown )); then
            break
        fi

        subsys_cmd
    done
}

### main logic

main() {
    systemd-notify --status "Starting..."
    echo "[-+-] Starting up."
    subsys_start
    
    systemd-notify --ready --status "Subsystem is running."
    monitor
    
    systemd-notify --status "Stopping..."
    echo "[-+-] Shutting down."
    subsys_stop
    
    systemd-notify --status "Stopped."
}

main
