#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

## set errexit, pipefail, errtrace
set -eEo pipefail

## do our checks
if [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

## set arrays
declare -a operational_users

## set vars
RWLIBDIR=/var/lib/subsystem
ROLIBDIR=/usr/lib/subsystem

## utilities
is_mounted() {
    local u
    for u in "${operational_users[@]}"; do
        [[ $u == "$1" ]] && return 0
    done
    return 1
}

drop_user() {
    local i
    for i in "${!operational_users[@]}"; do
        [[ ${operational_users[i]} == "$1" ]] && unset 'operational_users[i]'
    done
}

userfs() {
    local USERDIR HASH SUID_START SUID_RANGE SGID_START SGID_RANGE

    while read -r TARGETUSR; do
        case "$1" in
            mount)
                if is_mounted "$TARGETUSR"; then
                    echo "[-!-] Already mounted rootfs for user $TARGETUSR."
                    continue
                fi
                echo "[---] Mounting rootfs for user $TARGETUSR."
                operational_users+=("$TARGETUSR")

                read -r SUID_START SUID_RANGE <<< "$(awk -F: -v u="$TARGETUSR" '$1==u {print $2,$3}' /etc/subuid)"
                read -r SGID_START SGID_RANGE <<< "$(awk -F: -v u="$TARGETUSR" '$1==u {print $2,$3}' /etc/subgid)"
                if [[ -z $SUID_START || -z $SGID_START || -z $SUID_RANGE || -z $SGID_RANGE ]]; then
                    echo "[!!!] User $TARGETUSR has improperly configured sub{uid,gid}s, skipping."
                    drop_user "$TARGETUSR"
                    continue
                fi

                HASH=$(printf '%s%s' "$(</etc/machine-id)" "$TARGETUSR" | sha256sum | awk '{print $1}')
                USERDIR=$RWLIBDIR/$HASH

                trap 'echo "[!!!] Failed to mount rootfs for $TARGETUSR, skipping." && continue' ERR
                trap 'echo "[!!!] Received SIGTERM, stopping." && return 0' SIGTERM

                echo "[1/4] Setting up rootfs directory."
                rm -rf "${USERDIR:?}"/*
                mkdir -p "$USERDIR"/{rootfs,base/{home,root,bin,sbin,lib,lib64,etc,var,opt,tmp,run,srv,sys,dev,proc},data,.work}
                chown -R "$TARGETUSR":"$TARGETUSR" "$USERDIR"/

                echo "[2/4] Locking rootfs directory."
                mount --bind -o ro "$USERDIR"/base "$USERDIR"/base

                echo "[3/4] Mounting toplevel directories."
                for dir in etc var; do mount --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro,acl,loop,user_xattr -t erofs "$ROLIBDIR"/segments/"$dir".dsk "$USERDIR"/base/"$dir"; done
                for dir in srv opt; do mount --bind --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro /var/"$dir" "$USERDIR"/base/"$dir"; done
                for type in "$USERDIR"/base/lib{,64}; do mount --bind --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro /usr/lib "$type"; done
                for type in "$USERDIR"/base/{,s}bin; do mount --bind --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro /usr/bin "$type"; done

                echo "[4/4] Mounting rootfs overlay."
                mount -t overlay overlay -o index=off,lowerdir="$USERDIR"/base,upperdir="$USERDIR"/data,workdir="$USERDIR"/.work "$USERDIR"/rootfs

                trap - ERR SIGTERM
                ;;

            umount)
                if ! is_mounted "$TARGETUSR"; then
                    echo "[-!-] Already unmounted rootfs for user $TARGETUSR."
                    continue
                fi
                echo "[---] Unmounting rootfs for user $TARGETUSR."
                drop_user "$TARGETUSR"

                HASH=$(printf '%s%s' "$(</etc/machine-id)" "$TARGETUSR" | sha256sum | awk '{print $1}')
                USERDIR=$RWLIBDIR/$HASH

                trap 'echo "[!!!] Failed to unmount rootfs for $TARGETUSR, manual intervention is required." && continue' ERR

                echo "[1/4] Unmounting rootfs overlay."
                umount -q "$USERDIR"/rootfs

                echo "[2/4] Unmounting toplevel directories."
                for dir in bin sbin lib lib64 etc var opt srv; do umount -q "$USERDIR"/base/"$dir"; done

                echo "[3/4] Unlocking rootfs directory."
                umount "$USERDIR"/base

                echo "[4/4] Cleaning user subsystem rootfs."
                rm -rf "${USERDIR:?}"/*
                touch "$USERDIR"/user-inactive

                trap - ERR
                ;;
        esac
    done < <(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' /etc/passwd)
}

monitor() {
    trap 'kill "$NOTIFY_PID" 2>/dev/null; break' SIGTERM

    echo "[---] Monitoring for new users."


    while true; do
        inotifywait -e close_write /etc/passwd &
        local NOTIFY_PID=$!

        if ! wait $NOTIFY_PID 2>/dev/null; then
            break
        fi

        while read -r user; do
            if ! is_mounted "$user"; then
                echo "[-i-] New user(s) added, refreshing mounts."
                userfs mount
                break
            fi
        done < <(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' /etc/passwd)
    done

    trap - SIGTERM
}

## main logic
systemd-notify --status "Starting..."
echo "[-+-] Starting up."
userfs mount

systemd-notify --ready --status "Filesystems are mounted."
monitor

systemd-notify --status "Stopping..."
echo "[-+-] Shutting down."
userfs umount

systemd-notify --status "Stopped."