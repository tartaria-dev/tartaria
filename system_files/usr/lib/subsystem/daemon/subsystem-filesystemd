#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

### set errexit, pipefail, errtrace
set -eEo pipefail

### do our checks
if [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
fi

### set arrays
declare -a operational_users

### set vars
SOCATPID=
SHUTDOWN=0
RWLIBDIR=/var/lib/subsystem
ROLIBDIR=/usr/lib/subsystem
readonly RWLIBDIR ROLIBDIR

### set SIGTERM trap
trap 'SHUTDOWN=1; kill "$SOCATPID" 2>/dev/null || true' SIGTERM

### utilities

abort_mount() {
    trap - ERR
    userfs unmount "$1"
}

is_mounted() {
    for u in "${operational_users[@]}"; do
        if [[ $u == "$1" ]]; then
            return
        fi
    done
    
    return 1
}

drop_user() {
    for i in "${!operational_users[@]}"; do
        if [[ ${operational_users[i]} == "$1" ]]; then
            unset 'operational_users[i]'
        fi
    done
}

### rootfs actions

rootfs_mount() {
    local HASH USERDIR MNTERR S{U,G}ID_{START,RANGE}
    
    HASH=$(printf '%s%s' "$(</etc/machine-id)" "$2" | sha256sum | awk '{print $1}')
    USERDIR=$RWLIBDIR/$HASH

    readonly HASH USERDIR
    
    if [[ -z $2 ]]; then
        echo "[!!!] No target user given."
        return
    elif [[ -f "/var/home/$2/.config/subsystem/disable" ]]; then
        echo "[-!-] Subsystem disabled for user $2."
        return
    elif is_mounted "$2"; then
        echo "[-!-] Already mounted rootfs for user $2."
        return
    elif [[ -f "$USERDIR"/op.lock ]]; then
        echo "[-!-] Rootfs for user $2 is being operated on."
        return
    fi

    operational_users+=("$2")

    echo "[---] Mounting rootfs for user $2."

    touch "$USERDIR"/op.lock

    read -r SUID_START SUID_RANGE <<< "$(awk -F: -v u="$2" '$1==u {print $2,$3}' /etc/subuid)"
    read -r SGID_START SGID_RANGE <<< "$(awk -F: -v u="$2" '$1==u {print $2,$3}' /etc/subgid)"
    
    if [[ -z $SUID_START || -z $SGID_START || -z $SUID_RANGE || -z $SGID_RANGE ]]; then
        echo "[!!!] User $2 has improperly configured sub{uid,gid}s."
        drop_user "$2"
        return
    fi

    trap "echo '[!!!] Failed to mount rootfs for $2.'; MNTERR=1; return" ERR

    for step in dirs base overlay; do
        if (( SHUTDOWN )); then
            echo "[-i-] SIGTERM received, cancelling mount."
            abort_mount "$2"
            return
        fi

        "fs_$step"

        if (( MNTERR )); then
            abort_mount "$2"
            return
        fi
    done

    trap - ERR

    rm -f "$USERDIR"/op.lock
}

rootfs_unmount() {
    local HASH USERDIR
    
    HASH=$(printf '%s%s' "$(</etc/machine-id)" "$2" | sha256sum | awk '{print $1}')
    USERDIR=$RWLIBDIR/$HASH

    readonly HASH USERDIR
    
    if [[ -z $2 ]]; then
        echo "[!!!] No target user given."
        return
    elif ! is_mounted "$2"; then
        echo "[-!-] Already unmounted rootfs for user $2."
        return
    elif [[ -f "$USERDIR"/op.lock ]]; then
        echo "[-!-] Rootfs for user $2 is being operated on."
        return
    fi

    echo "[---] Unmounting rootfs for user $2."
    
    drop_user "$2"

    trap 'echo "[!!!] Failed to unmount rootfs for $2, manual intervention is required." && return' ERR

    echo "[1/2] Unmounting rootfs directories."
    
    for dir in {rootfs,overlay/base}/{bin,sbin,lib,lib64,etc,var,srv,opt,usr} rootfs overlay/base; do
        umount "$USERDIR/$dir" || true
    done

    echo "[2/2] Cleaning rootfs directories."
    
    rm -rf "${USERDIR:?}"/*

    trap - ERR

    rm -f "$USERDIR"/op.lock
}

rootfs_clean_all() {
    local ALLUSRDIRS ACTIVEUSRDIRS
    
    for dir in "$RWLIBDIR"/*; do
        ALLUSRDIRS+=("$dir")
    done

    while read -r PSWDUSR; do
        HASH=$(printf '%s%s' "$(</etc/machine-id)" "$PSWDUSR" | sha256sum | awk '{print $1}')
        USERDIR=$RWLIBDIR/$HASH
        ACTIVEUSRDIRS+=("$USERDIR")
    done < <(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' /etc/passwd)

    for usrdir in "${ALLUSRDIRS[@]}"; do
        if [[ " ${ACTIVEUSRDIRS[*]} " != *" $usrdir "* ]]; then
            rm -rf "$usrdir"
        fi
    done
}

rootfs_unmount_all() {
    for activeuser in "${operational_users[@]}"; do
        rootfs_unmount "$activeuser"
    done
}

### rootfs mount steps

fs_dirs() {
    echo "[1/3] Preparing rootfs directories."
    
    for dir in {rootfs,overlay/base}/{bin,sbin,lib,lib64,etc,var,srv,opt,usr} rootfs overlay/base; do
        umount -q "$USERDIR/$dir" || true
    done
    
    rm -rf "${USERDIR:?}"/*
    mkdir -p "$USERDIR"/{rootfs,overlay/{base,data,work}/{rfs,bin,sbin,lib,lib64,etc,var,srv,opt,usr},overlay/base/rfs/{home,root,bin,sbin,lib,lib64,etc,var,srv,opt,usr,tmp,run,sys,dev,proc}}
    chown -R "$SUID_START":"$SGID_START" "$USERDIR"/

    mount --bind "$USERDIR"/overlay/base "$USERDIR"/overlay/base
    mount -o remount,bind,ro "$USERDIR"/overlay/base
}

fs_base() {
    echo "[2/3] Mounting base directories."
    
    mount -t overlay overlay -o index=off,lowerdir="$USERDIR"/overlay/base/rfs,upperdir="$USERDIR"/overlay/data/rfs,workdir="$USERDIR"/overlay/work/rfs "$USERDIR"/rootfs
    
    for dir in etc var; do
        mount --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro,acl,loop,user_xattr -t erofs "$ROLIBDIR"/segments/"$dir".dsk "$USERDIR"/overlay/base/"$dir"
    done
    
    for dir in srv opt; do
        mount --bind --map-users 0:"$SUID_START":"$SUID_RANGE" --map-groups 0:"$SGID_START":"$SGID_RANGE" -o ro /var/"$dir" "$USERDIR"/overlay/base/"$dir"
    done
    
    bindfs --uid-offset="$SUID_START" --gid-offset="$SGID_START" -o ro /usr "$USERDIR"/overlay/base/usr

    for dir in "$USERDIR"/overlay/base/lib{,64}; do
        bindfs --uid-offset="$SUID_START" --gid-offset="$SGID_START" -o ro /usr/lib "$dir"
    done

    for dir in "$USERDIR"/overlay/base/{,s}bin; do
        bindfs --uid-offset="$SUID_START" --gid-offset="$SGID_START" -o ro /usr/bin "$dir"
    done
}

fs_overlay() {
    echo "[3/3] Mounting overlay directories."
    
    for dir in etc var srv opt usr lib{,64} {,s}bin; do
        mount -t overlay overlay -o index=off,lowerdir="$USERDIR"/overlay/base/"$dir",upperdir="$USERDIR"/overlay/data/"$dir",workdir="$USERDIR"/overlay/work/"$dir" "$USERDIR"/rootfs/"$dir"
    done
}

### monitoring

monitor() {
    local WFD REPLY ACTION PSWDUSR
    
    rm -f "$RUNTIME_DIRECTORY"/fsrequests.sock
    echo "[---] Monitoring for requests on $RUNTIME_DIRECTORY/fsrequests.sock."

    while (( ! SHUTDOWN )); do
        coproc CONN { exec socat -T10 UNIX-LISTEN:"$RUNTIME_DIRECTORY"/fsrequests.sock,mode=666,unlink-early STDIO; }
        
        SOCATPID=$CONN_PID
        WFD=${CONN[1]}
        REPLY=""

        if IFS= read -rn 200 LINE <&"${CONN[0]}"; then
            LINE=${LINE%$'\r'}

            if [[ $LINE != *-* ]]; then
                REPLY="invalid_format"
            else
                ACTION=${LINE%%-*}
                PSWDUSR=${LINE#*-}

                if [[ "$ACTION" != "mount" && "$ACTION" != "unmount" ]]; then
                    REPLY="unknown_cmd"
                elif ! awk -F: -v u="$PSWDUSR" '$1==u && $3>=1000 && $3!=65534 {f=1} END{exit !f}' /etc/passwd; then
                    REPLY="unknown_user"
                else
                    echo "[-i-] Received request to $ACTION rootfs for $PSWDUSR."
                    
                    "rootfs_$ACTION" "$PSWDUSR"

                    if [[ $ACTION == mount ]] && is_mounted "$PSWDUSR"; then
                        REPLY="mounted"
                    elif [[ $ACTION == unmount ]] && ! is_mounted "$PSWDUSR"; then
                        REPLY="unmounted"
                    else
                        REPLY="failed"
                    fi
                fi
            fi

            printf '%s\n' "$REPLY" >&"$WFD" || true
        fi

        exec {WFD}>&-
        wait "$SOCATPID" 2>/dev/null || true
    done

    rm -f "$RUNTIME_DIRECTORY"/fsrequests.sock
}

### main logic

main() {
    systemd-notify --status "Starting..."
    echo "[-+-] Starting up."
    rootfs_clean_all
    
    systemd-notify --ready --status "Monitoring for requests."
    monitor
    
    systemd-notify --status "Stopping..."
    echo "[-+-] Shutting down."
    rootfs_unmount_all
    rootfs_clean_all
    
    systemd-notify --status "Stopped."
}

main
