set -e

readonly STORE="/etc/subsystem/.store"

[[ "$EUID" != "0" ]] && echo "Please run this as an administrator." && exit 1

if ! getent passwd subsys > /dev/null; then
    groupadd -rg 767 subsys
    useradd -rmd /etc/subsystem -u 767 -g 767 -s /usr/bin/nologin subsys
    loginctl enable-linger subsys
fi

case $1 in
    store-mount)
        echo "Mounting subsystem image store."
        machinectl shell -q subsys@.host /usr/bin/mkdir -p "$STORE"/{store,data,.work}
        ! findmnt "$STORE"/store > /dev/null && mount -t overlay overlay -o lowerdir=/usr/lib/subsystem-store,upperdir="$STORE"/data,workdir="$STORE"/.work "$STORE"/store || true
        ;;
    store-unmount)
        echo "Unmounting subsystem image store."
        findmnt "$STORE"/store > /dev/null && umount "$STORE"/store || true
        ;;
    poweron)
        echo "Powering subsystem on."
        systemctl -M subsys@.host --user daemon-reload
        systemctl -M subsys@.host --user start subsystem.service
        ;;
    poweroff)
        echo "Powering subsystem off."
        systemctl -M subsys@.host --user stop subsystem.service
        ;;
    *)
        echo "Subsystem management utility 1.0"
        echo "Usage: $0 store-mount|store-umount|poweron|poweroff"
        exit 1
        ;;
esac
