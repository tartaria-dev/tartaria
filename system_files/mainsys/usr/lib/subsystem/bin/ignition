#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# do our checks
if [[ "$EUID" != "0" ]]; then
    echo "[!!!] Please run this as an administrator."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

# logging
echo "[---] Starting up."

# set constants
directory='/var/lib/pacman/local'
pkg_pattern='-[0-9]+([.:][0-9]+)*-[0-9]+$'
readonly directory
readonly pkg_pattern

# set up sudo for the user
if [[ ! -f /etc/sudoers.d/nopasswd-for-subsystem ]]; then
    mkdir -p /etc/sudoers.d
	echo "$SUBSYSTEM_USER ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/nopasswd-for-subsystem
fi

# source user configs
echo "[1/2] Sourcing user configurations."
if [[ -d /etc/ignition.d/ ]]; then
	for script in /etc/ignition.d/*.sh; do
		echo "[i] Sourcing script $script."
		. "$script" || true
	done
fi

# attempt to configure fastest arch repos
echo "[2/2] Configuring repositories."
if [[ ! -f /etc/.ignition-repo-conf-done ]]; then
    reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist >/dev/null 2>&1 || true
    pacman -Sy >/dev/null 2>&1 || true
    touch /etc/.ignition-repo-conf-done
fi

# keep subsystem alive
echo "[---] Startup done."
sleep infinity
