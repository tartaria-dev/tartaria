#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

## do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

## constants
NORM=$(tput sgr0)
GRAY=$(tput setaf 7)
RED=$(tput setaf 1)
SUBSYS_ID=$(echo -n "$(cat /etc/machine-id)$USER" | sha256sum | awk '{print $1}')
TRYCOUNTER=0
WAITED_SECONDS=0
readonly RED
readonly GRAY
readonly NORM
readonly SUBSYS_ID

## utilities
shell() {
    while [[ "$TRYCOUNTER" -lt "10" ]]; do
        if podman exec -u "$(id -u)" -it "subsystem-$SUBSYS_ID" /bin/zsh; then
            exit 0
        else
            TRYCOUNTER=$(( "$TRYCOUNTER" + 1 ))
        fi
    done

    err-entry
    exec bash
}

throbber() {
    local msg="Starting..."
    local frames=("/" "-" "\\" "|")

    for frame in "${frames[@]}"; do
        printf "\r[%s] %s" "$frame" "$msg"
        sleep 0.25
    done
}

err-entry() {
    clear
    cat <<EOF
${RED}Oops,

Something went wrong while trying to enter your subsystem.
Logs containing relevant information can be viewed with the following command:${NORM}

${GRAY}journalctl --user -xeu subsystem-containerd${NORM}

${RED}Manual intervention/debugging may be required.
Falling back to non-login host shell (bash)...${NORM}

EOF
}

err-servfail() {
    clear
    cat <<EOF
${RED}Oops,

Your subsystem has failed to start.
Logs containing relevant information can be viewed with the following command:${NORM}

${GRAY}journalctl --user -xeu subsystem-containerd${NORM}

${RED}Manual intervention/debugging may be required.
Falling back to non-login host shell (bash)...${NORM}

EOF
}

## main logic
if [[ "$(systemctl --user is-failed subsystem-containerd)" == "active" ]]; then
    shell
else
    if [[ "$(systemctl --user is-failed subsystem-containerd)" == "activating" ]]; then
        while [[ "$(systemctl --user is-failed subsystem-containerd)" == "activating" ]]; do
            throbber
            WAITED_SECONDS=$(( "WAITED_SECONDS" + 1 ))

            if [[ "$WAITED_SECONDS" -gt "15" ]]; then
                err-entry
                exec bash
            fi
        done

        if [[ "$(systemctl --user is-failed subsystem-containerd)" == "active" ]]; then
            shell
        else
            err-servfail
            exec bash
        fi
    else
        err-servfail
        exec bash
    fi
fi
