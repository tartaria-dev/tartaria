[Unit]
Description=Stage Tartaria's Secure Boot signing cert for MOK enrollment
ConditionPathExists=/usr/share/tartaria/secureboot/tartaria.der
ConditionPathExists=!/etc/tartaria/mok-enrolled
Before=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/sys-mok-enroll

[Install]
WantedBy=multi-user.target
