[Unit]
Description=Install system flatpaks
After=var.mount
Requires=var.mount
ConditionPathExists=/etc/.sysapps.list
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/libexec/install-flatpak-sysapps
RemainAfterExit=false
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target