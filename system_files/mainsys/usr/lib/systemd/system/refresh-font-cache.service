[Unit]
Description=Refresh system/user font cache
After=var.mount
Requires=var.mount
ConditionPathExists=!/var/lib/tartaria/font-cache-refresh-done

[Service]
Type=oneshot
ExecStart=mkdir -p /var/lib/tartaria
ExecStart=/usr/bin/fc-cache -rsfv
ExecStart=/usr/libexec/run-as-all-human-users "fc-cache -rfv"
ExecStart=touch /var/lib/tartaria/font-cache-refresh-done
RemainAfterExit=false

[Install]
WantedBy=multi-user.target