[Unit]
Description=Subsystem for %u
After=graphical-session.target
RequiresMountsFor=%t/containers
RequiresMountsFor=/run/user/%U
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
KillSignal=SIGTERM
ExecStart=/usr/lib/subsystem/daemon/subsystem-containerd
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
