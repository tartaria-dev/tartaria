[Unit]
Description=Subsystem container
After=local-fs.target subsys.mount subsys-home.mount
BindsTo=subsys.mount subsys-home.mount

[Container]
ContainerName=subsystem
HostName=subsystem
EnvironmentHost=true
LogDriver=journald
Rootfs=/subsys
Network=host
RunInit=yes

[Service]
Restart=on-failure
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target default.target