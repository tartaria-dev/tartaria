[Unit]
Description=Subsystem container

[Container]
ContainerName=subsystem
HostName=subsystem
EnvironmentHost=true
Entrypoint=/usr/lib/systemd/systemd
Exec=--unit=multi-user.target
LogDriver=journald
Rootfs=/subsys
Mount=type=tmpfs,dest=/tmp
Mount=type=tmpfs,dest=/run
Volume=/run/dbus:/run/dbus:ro
Network=host