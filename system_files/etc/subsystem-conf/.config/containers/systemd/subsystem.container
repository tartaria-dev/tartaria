[Unit]
Description=Subsystem container
RequiresMountsFor=/usr/lib/subsystem/rootfs /subsys/home /subsys
After=local-fs.target

[Container]
ContainerName=subsystem
HostName=subsystem
EnvironmentHost=true
RunInit=yes
LogDriver=journald
Rootfs=/subsys
Mount=type=tmpfs,tmpfs-size=64M,dest=/run,tmpcopyup=false
Mount=type=tmpfs,tmpfs-size=64M,dest=/var/log,tmpcopyup=false
Mount=type=tmpfs,tmpfs-size=64M,dest=/tmp,tmpcopyup=false
Network=host

[Install]
WantedBy=multi-user.target default.target