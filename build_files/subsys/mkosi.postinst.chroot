#!/usr/bin/env bash
# post-installation script for mkosi rootfs generation

set -ouex pipefail

# init keys
pacman-key --init
pacman-key --populate archlinux

# disable pacman sandboxing
sed -i 's/^#DisableSandbox/DisableSandbox/' /etc/pacman.conf

# install aur pkgs
useradd -m builder
mkdir /etc/sudoers.d
echo "builder ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builder
su - builder -c "cd /home/builder && \
    git clone https://aur.archlinux.org/yay-bin.git && \
    cd yay-bin && \
    makepkg -si --noconfirm && \
    cd .. && \
    rm -rf yay-bin && \
    yay -S --noconfirm zsh-theme-powerlevel10k-git"
userdel -r builder
rm -rf /etc/sudoers.d

# fix unknown key warning
find /var/lib/pacman/local/ -type f -name "desc" -exec sed -i '/^%INSTALLED_DB%$/,+2d' {} \;

# allow access to containerization utils on the host
ln -sT /usr/libexec/host-spawn /usr/bin/distrobox
ln -sT /usr/libexec/host-spawn /usr/bin/podman
ln -sT /usr/libexec/host-spawn /usr/bin/docker

# generate locales
echo -e "en_US.UTF-8 UTF-8\nde_DE.UTF-8 UTF-8\nfr_FR.UTF-8 UTF-8\nja_JP.UTF-8 UTF-8\nes_ES.UTF-8 UTF-8" > /etc/locale.gen
locale-gen

# update dynamic linker cache
ldconfig

# fix os-release files
rm -f /etc/os-release
sed -i "s/Arch/Tartaria ($IMAGE_VARIANT)/g" /usr/lib/os-release
ln -sT /usr/lib/os-release /etc/os-release

# setup zsh prompt
mkdir -p /etc/zsh
cat /etc/zshrc-addons >> /etc/zsh/zshrc
rm -f /etc/zshrc-addons

# cleanup
rm -rf {/{home,tmp,var/{log,tmp}}/*,/{boot,efi,init,.gnupg}}
