mkdir -p /var/tmp

script_cleanup() {
    userdel builder || true
    rm -rf /output/{artifacts,logs}/* /var/tmp
}

retry() {
    local ATTEMPT=1
    local CMD=("$@")

    until "${CMD[@]}"; do
        if (( ATTEMPT >= 3 )); then
            echo "Command failed after ${ATTEMPT} attempts." >&2
            return 1
        fi

        echo "Attempt ${ATTEMPT} failed, retrying." >&2

        rm -rf /output/logs/*
        sleep 2

        (( ATTEMPT++ ))
    done
}
