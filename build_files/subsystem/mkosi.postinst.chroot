#!/bin/sh
# post setup script for subsystem

set -ouex pipefail

# enable community and testing repositories for additional packages
cat >> /etc/apk/repositories << 'EOF'
https://dl-cdn.alpinelinux.org/alpine/edge/community
https://dl-cdn.alpinelinux.org/alpine/edge/testing
EOF

# update package index
apk update

# install additional packages from community/testing
apk add --no-cache atuin fastfetch starship

# setup OpenRC
rc-update add dbus default
rc-update add syslog boot
rc-update add crond default
sed -i 's/^#rc_parallel="NO"/rc_parallel="YES"/' /etc/rc.conf

# basic doas config
cat > /etc/doas.conf << 'EOF'
permit persist :wheel
EOF
chmod 0400 /etc/doas.conf

# manually install ble.sh
git clone --recursive --depth 1 https://github.com/akinomyoga/ble.sh.git /tmp/ble.sh
make -C /tmp/ble.sh install PREFIX=/usr/local
rm -rf /tmp/ble.sh

# generate locales
echo -e "en_US.UTF-8 UTF-8\nde_DE.UTF-8 UTF-8\nfr_FR.UTF-8 UTF-8\nja_JP.UTF-8 UTF-8\nes_ES.UTF-8 UTF-8" > /etc/locale.gen
locale-gen

# update dynamic linker cache
ldconfig

# setup bash prompt
echo -e '\n[[ $- == *i* ]] && source -- /usr/share/blesh/ble.sh\n\neval "$(starship init bash)"\neval "$(atuin init bash)"' >> /etc/bash/bashrc

# cleanup
apk cache clean
