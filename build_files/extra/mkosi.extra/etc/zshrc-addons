alias fastfetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"
alias neofetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"
alias hyfetch="fastfetch --logo /usr/share/tartaria/ascii-logo/logo.txt"

if [[ $- == *i* ]]; then
    source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
    eval "$(atuin init zsh)"

    if [[ ! -f ~/.config/subsystem/suppress-notice ]]; then
        cat <<EOF
Hello there!

Your shell is currently running inside a Arch-based subsystem.
This subsystem is seperate from the host, meaning all changes
besides those to your home directory do not affect the host.

This also means a different set of commands is available.
To see how to run commands on the host, or link/unlink commands
from the host into this subsystem, run 'synergy --help'.

To suppress this lovely notice, execute:
touch ~/.config/subsystem/suppress-notice

EOF
    fi
fi