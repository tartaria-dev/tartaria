#!/usr/bin/env bash
# post-installation script for mkosi rootfs generation

set -ouex pipefail

# setup build user
useradd -m builder
echo "builder ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-installer

# build and install yay
su - builder -c "git clone https://aur.archlinux.org/yay.git ~/yay && \
                cd ~/yay && \
                makepkg -si --noconfirm"

# install ble.sh
su - builder -c "yay -S --noconfirm blesh-git"

# cleanup yay install
rm -rf /home/builder /etc/sudoers.d/10-installer
pkill -u builder
userdel -r builder

# allow access to containerization utils on the host
ln -sT /usr/libexec/host-spawn /usr/bin/distrobox
ln -sT /usr/libexec/host-spawn /usr/bin/podman
ln -sT /usr/libexec/host-spawn /usr/bin/docker

# generate locales
echo -e "en_US.UTF-8 UTF-8\nde_DE.UTF-8 UTF-8\nfr_FR.UTF-8 UTF-8\nja_JP.UTF-8 UTF-8\nes_ES.UTF-8 UTF-8" > /etc/locale.gen
locale-gen

# update dynamic linker cache
ldconfig

# setup bash prompt
cat /etc/bashrc-replace >> /etc/bash.bashrc
rm -f /etc/bashrc-replace

# disable pacman sandboxing
sed -i 's/^#DisableSandbox/DisableSandbox/' /etc/pacman.conf

# cleanup rootfs before import
rm -rf {/{home,tmp,var{/log,/tmp}}/*,/{boot,efi,init,.gnupg}}
