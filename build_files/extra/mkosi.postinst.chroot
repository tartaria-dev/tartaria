#!/usr/bin/env bash
# post-installation script for mkosi rootfs generation

set -e

# allow access to various utilities on the host
ln -sT /usr/libexec/host-spawn /usr/bin/sysexec
ln -sT /usr/libexec/host-spawn /usr/bin/distrobox
ln -sT /usr/libexec/host-spawn /usr/bin/podman
ln -sT /usr/libexec/host-spawn /usr/bin/docker
ln -sT /usr/libexec/host-spawn /usr/bin/ostree
ln -sT /usr/libexec/host-spawn /usr/bin/bootc

# passwordless sudo! you love to fucking see it
echo "ALL ALL=(ALL) NOPASSWD: ALL" | tee -a /etc/sudoers.d/nopasswd

# generate locales
echo -e "en_US.UTF-8 UTF-8\nde_DE.UTF-8 UTF-8\nfr_FR.UTF-8 UTF-8\nja_JP.UTF-8 UTF-8\nes_ES.UTF-8 UTF-8" > /etc/locale.gen
locale-gen

# update dynamic linker cache
ldconfig

# setup fish prompt
mkdir -p /etc/fish
echo -e '\nset -gx container subsystem' >> /etc/fish/config.fish
echo -e '\nif status is-interactive\n    starship init fish | source\n    atuin init fish | source\nend' >> /etc/fish/config.fish

# disable pacman sandboxing
sed -i 's/^#DisableSandbox/DisableSandbox/' /etc/pacman.conf

# cleanup rootfs before import
rm -rf {/{home,tmp,var{/log,/tmp}}/*,/{boot,efi,init,.gnupg}}
